# Server Configuration
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# MongoDB Connection
# Use local MongoDB (e.g., mongodb://localhost:27017/stepup_shoes) or MongoDB Atlas M0 free tier URI:
MONGODB_URI=mongodb://localhost:27017/stepup_shoes

# JWT Secret for Cookie-based Sessions
JWT_SECRET=super_secret_jwt_key_stepup_shoe_ecommerce_2026_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (Free tier: https://cloudinary.com)
# If left blank or invalid in development, system falls back to optimized SVG/mock placeholder CDN images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration (Free Gmail SMTP App Password or Brevo)
# If left unconfigured, emails are safely logged to the server console in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StepUp Shoes" <noreply@stepupshoes.com>

# SSLCommerz Sandbox (Optional - Leave blank for Cash on Delivery & bKash/Nagad manual)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_IS_SANDBOX=true
