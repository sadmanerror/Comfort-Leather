<!-- Global Modals Partial -->

<!-- 1. Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 pt-0" id="quickViewModalBody">
        <div class="row g-4 align-items-center">
          <div class="col-12 col-md-6 text-center">
            <img id="qvImage" src="/img/placeholder-shoe.svg" class="img-fluid rounded-3 border w-100 object-fit-cover" style="aspect-ratio: 1/1;" alt="Product">
          </div>
          <div class="col-12 col-md-6">
            <span class="badge bg-light text-dark border mb-2" id="qvBrand">Brand</span>
            <h4 class="fw-bold text-dark mb-2" id="qvTitle">Product Name</h4>
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="fs-4 fw-bold text-danger" id="qvPrice">Tk 0.00</span>
              <span class="text-muted text-decoration-line-through small" id="qvOldPrice"></span>
            </div>
            <p class="text-muted small mb-3" id="qvDesc">Short description</p>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Select Color</label>
              <div class="d-flex flex-wrap gap-2" id="qvColors"></div>
            </div>

            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label small fw-semibold text-secondary m-0">Select Size (BD/UK)</label>
                <a href="#" class="small text-danger text-decoration-none" data-bs-toggle="modal" data-bs-target="#sizeChartModal">Size Chart</a>
              </div>
              <div class="d-flex flex-wrap gap-2" id="qvSizes"></div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-danger flex-grow-1 fw-bold py-2" id="qvAddToCartBtn">
                <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
              </button>
              <a href="#" id="qvFullDetailsBtn" class="btn btn-outline-dark py-2 px-3" title="Full Details">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 2. Size Chart Modal -->
<div class="modal fade" id="sizeChartModal" tabindex="-1" aria-labelledby="sizeChartModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold" id="sizeChartModalLabel">
          <i class="fa-solid fa-ruler-combined text-danger me-2"></i>Footwear Sizing Chart
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <img src="<%= (settings && settings.defaultSizeChartUrl) || '/img/size-chart.svg' %>" class="img-fluid rounded border mb-3" alt="Size Chart">
        <div class="alert alert-light border small text-start mb-0">
          <strong>Tip for Bangladeshi Feet:</strong> If you usually wear half sizes or have a broader forefoot, we recommend ordering one size up for maximum comfort.
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 3. Header Login Modal -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 400px;">
    <div class="modal-content border-0 shadow-lg rounded-4 p-3">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="loginModalLabel">Customer Sign In</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form action="/account/login" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Email Address</label>
            <input type="email" name="email" class="form-control form-control-sm" required autofocus placeholder="name@example.com">
          </div>
          <div class="mb-3">
            <div class="d-flex justify-content-between">
              <label class="form-label small fw-semibold text-secondary">Password</label>
              <a href="/account/forgot-password" class="small text-danger text-decoration-none">Forgot?</a>
            </div>
            <input type="password" name="password" class="form-control form-control-sm" required placeholder="Password">
          </div>
          <button type="submit" class="btn btn-danger w-100 btn-sm py-2 fw-bold mb-3">
            Sign In
          </button>
        </form>
        <div class="text-center border-top pt-3 small text-muted">
          Don't have an account? <a href="/account/register" class="text-danger fw-semibold text-decoration-none">Register Now</a>
        </div>
      </div>
    </div>
  </div>
</div>
