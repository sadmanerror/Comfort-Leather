      </div>

      <!-- Contact Block -->
      <div class="col-12 col-md-6 col-lg-3">
        <h6 class="fw-bold text-uppercase small text-white mb-3" style="letter-spacing: 0.5px;">Connect With Us</h6>
        <p class="small text-secondary mb-2">
          <strong><%= (settings && settings.storeName) || 'Comfort Leather' %> Footwear Bangladesh</strong><br>
          <%= (settings && settings.address) || 'House 42, Road 11, Gulshan-1, Dhaka-1212' %>
        </p>
        <p class="small text-secondary mb-2">
          <i class="fa-solid fa-phone text-danger me-2"></i><%= (settings && settings.contactPhone) || '09666200300' %> (9am - 10pm)
        </p>
        <p class="small text-secondary mb-3">
          <i class="fa-solid fa-envelope text-danger me-2"></i><%= (settings && settings.contactEmail) || 'support@comfortleather.com' %>
