        <!-- Social Icons -->
        <div class="d-flex gap-2">
          <a href="https://facebook.com" target="_blank" class="btn btn-sm btn-outline-secondary rounded-circle text-white p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;"><i class="fa-brands fa-facebook-f"></i></a>
