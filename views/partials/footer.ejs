          <a href="https://twitter.com" target="_blank" class="btn btn-sm btn-outline-secondary rounded-circle text-white p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;"><i class="fa-brands fa-x-twitter"></i></a>
        </div>
      </div>
    </div>

    <!-- Payment Badges & Copyright Bottom Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between pt-4 border-top border-secondary border-opacity-50 small text-secondary gap-3">
      <div>
        &copy; <span id="currentYear"><%= new Date().getFullYear() %></span> <%= (settings && settings.storeName) || 'Comfort Leather' %> Bangladesh Ltd. All Rights Reserved.
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white text-dark py-1 px-2 border">Cash on Delivery</span>
        <span class="badge text-white py-1 px-2" style="background-color: #E2136E;">bKash</span>
        <span class="badge text-white py-1 px-2" style="background-color: #F7941D;">Nagad</span>
        <span class="badge bg-primary py-1 px-2">Visa</span>
        <span class="badge bg-warning text-dark py-1 px-2">Mastercard</span>
      </div>
    </div>
  </div>
</footer>

<script>
  // Newsletter AJAX subscription
  const nForm = document.getElementById('newsletterForm');
  if (nForm) {
    nForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('newsletterEmail').value;
      const successDiv = document.getElementById('newsletterSuccess');
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        successDiv.style.display = 'block';
        successDiv.innerText = data.message || 'Subscribed successfully!';
        nForm.reset();
      } catch (err) {
        successDiv.style.display = 'block';
        successDiv.innerText = 'Thank you for subscribing!';
      }
    });
  }
</script>
