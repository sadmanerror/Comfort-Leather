        </ul>
      </div>

      <!-- Information -->
      <div class="col-6 col-md-3 col-lg-2">
        <h6 class="fw-bold text-uppercase small text-white mb-3" style="letter-spacing: 0.5px;">Information</h6>
        <ul class="list-unstyled small text-secondary mb-0">
          <li class="mb-2"><a href="/pages/terms-and-conditions" class="text-secondary text-decoration-none hover-white">Terms &amp; Conditions</a></li>
          <li class="mb-2"><a href="/pages/payment-options" class="text-secondary text-decoration-none hover-white">Payment Options</a></li>
          <li class="mb-2"><a href="/pages/privacy-policy" class="text-secondary text-decoration-none hover-white">Privacy Policy</a></li>
