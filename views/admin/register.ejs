<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Administrator Account | CL Admin</title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/tw.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body {
      background: linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 100%);
      min-height: 100vh;
    }
    .register-card {
      max-width: 480px;
      width: 100%;
      border-radius: 1.25rem;
    }
  </style>
</head>
<body class="d-flex align-items-center justify-content-center py-5 px-3">
  <div class="card register-card shadow-2xl border-0 p-4 p-sm-5 bg-white">
    <div class="text-center mb-4">
      <img src="/img/logo.svg" alt="Comfort Leather" height="42" class="mb-3">
      <div class="d-inline-block px-3 py-1 bg-danger bg-opacity-10 text-danger rounded-pill small fw-bold mb-2">
        <i class="fa-solid fa-shield-halved me-1"></i> CL ADMIN ACCESS
      </div>
      <h4 class="fw-bold text-dark m-0">Create Administrator</h4>
      <p class="text-muted small m-0">Sign up with full administrative permissions</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/admin/register" method="POST" id="adminRegisterForm">
      <!-- Full Name -->
      <div class="mb-3">
        <label class="form-label fw-semibold small text-secondary">Full Name <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-user"></i></span>
          <input type="text" name="name" class="form-control border-start-0 ps-0" placeholder="e.g. John Doe" required value="<%= formData?.name || '' %>">
        </div>
      </div>

      <!-- Email Address -->
      <div class="mb-3">
        <label class="form-label fw-semibold small text-secondary">Email Address <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
          <input type="email" name="email" class="form-control border-start-0 ps-0" placeholder="admin@comfortleather.com" required value="<%= formData?.email || '' %>">
        </div>
      </div>

      <!-- Phone Number -->
      <div class="mb-3">
        <label class="form-label fw-semibold small text-secondary">Phone Number</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-phone"></i></span>
          <input type="text" name="phone" class="form-control border-start-0 ps-0" placeholder="017XXXXXXXX" value="<%= formData?.phone || '' %>">
        </div>
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label class="form-label fw-semibold small text-secondary">Password <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
          <input type="password" name="password" id="regPassword" class="form-control border-start-0 ps-0" placeholder="Minimum 6 characters" required minlength="6">
        </div>
      </div>

      <!-- Confirm Password -->
      <div class="mb-4">
        <label class="form-label fw-semibold small text-secondary">Confirm Password <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-check-double"></i></span>
          <input type="password" name="confirmPassword" id="regConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Re-enter password" required minlength="6">
        </div>
        <div id="passwordMismatchError" class="text-danger small mt-1 d-none">
          <i class="fa-solid fa-triangle-exclamation me-1"></i> Passwords do not match
        </div>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold shadow-sm">
        Create CL Admin Account <i class="fa-solid fa-arrow-right ms-1"></i>
      </button>
    </form>

    <div class="mt-4 pt-3 border-top text-center">
      <span class="text-muted small">Already have an admin account?</span>
      <a href="/admin/login" class="fw-bold text-dark text-decoration-none small ms-1">
        Sign In to CL Admin <i class="fa-solid fa-right-to-bracket ms-1"></i>
      </a>
    </div>

    <div class="mt-3 text-center">
      <a href="/" class="text-muted text-decoration-none small">
        <i class="fa-solid fa-arrow-left me-1"></i> Return to Public Storefront
      </a>
    </div>
  </div>

  <script>
    const form = document.getElementById('adminRegisterForm');
    const pwd = document.getElementById('regPassword');
    const confirmPwd = document.getElementById('regConfirmPassword');
    const mismatch = document.getElementById('passwordMismatchError');

    form.addEventListener('submit', (e) => {
      if (pwd.value !== confirmPwd.value) {
        e.preventDefault();
        mismatch.classList.remove('d-none');
        confirmPwd.focus();
      } else {
        mismatch.classList.add('d-none');
      }
    });

    confirmPwd.addEventListener('input', () => {
      if (pwd.value && confirmPwd.value && pwd.value !== confirmPwd.value) {
        mismatch.classList.remove('d-none');
      } else {
        mismatch.classList.add('d-none');
      }
    });
  </script>
</body>
</html>
