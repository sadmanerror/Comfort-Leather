<!-- Blog Posts Management -->
<div class="container-fluid p-0">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark m-0">Blog Stories &amp; Style Guides</h3>
      <p class="text-muted small m-0">Publish shoe styling guides, leather care instructions, and brand stories</p>
    </div>
    <button class="btn btn-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#blogModal" onclick="openAddBlog()">
      <i class="fa-solid fa-plus me-1"></i> Add Article
    </button>
  </div>

  <div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 text-nowrap">
        <thead class="table-light small text-secondary">
          <tr>
            <th class="ps-3">Article Title</th>
            <th>Author</th>
            <th>Published Date</th>
            <th>Status</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody class="small">
          <% if (posts && posts.length) { %>
            <% posts.forEach(p => { %>
              <tr>
                <td class="ps-3 fw-bold text-dark">
                  <a href="/blogs/stories/<%= p.slug %>" target="_blank" class="text-dark text-decoration-none hover-underline">
                    <%= p.title %>
                  </a>
                </td>
                <td class="text-muted"><%= p.author %></td>
                <td class="text-muted"><%= p.publishedAt ? p.publishedAt.toLocaleDateString('en-GB') : '&mdash;' %></td>
                <td>
                  <span class="badge <%= p.isPublished ? 'bg-success' : 'bg-secondary' %>">
                    <%= p.isPublished ? 'Published' : 'Draft' %>
                  </span>
                </td>
                <td class="text-end pe-3">
                  <button type="button" class="btn btn-sm btn-outline-secondary py-1" onclick="openEditBlog('<%= p._id %>', '<%= p.title.replace(/'/g, '\\\'') %>', '<%= p.slug %>', '<%= (p.excerpt || '').replace(/'/g, '\\\'') %>', `<%= p.content.replace(/`/g, '\\`') %>`, '<%= p.author %>', '<%= p.tags ? p.tags.join(', ') : '' %>', <%= p.isPublished %>)">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted">No blog stories published yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Blog Modal -->
<div class="modal fade" id="blogModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header">
        <h6 class="modal-title fw-bold" id="blogModalTitle">Add Blog Post</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/blogs" method="POST">
        <input type="hidden" name="id" id="blogId">
        <div class="modal-body">
          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6">
              <label class="form-label small fw-semibold">Title <span class="text-danger">*</span></label>
              <input type="text" name="title" id="blogTitle" class="form-control" required>
            </div>
            <div class="col-12 col-sm-6">
              <label class="form-label small fw-semibold">Slug <span class="text-danger">*</span></label>
              <input type="text" name="slug" id="blogSlug" class="form-control" required>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6">
              <label class="form-label small fw-semibold">Author</label>
              <input type="text" name="author" id="blogAuthor" class="form-control" value="CL Editorial">
            </div>
            <div class="col-12 col-sm-6">
              <label class="form-label small fw-semibold">Tags (comma-separated)</label>
              <input type="text" name="tags" id="blogTags" class="form-control" placeholder="Style Guide, Leather Care">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Short Excerpt</label>
            <textarea name="excerpt" id="blogExcerpt" rows="2" class="form-control"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Article Content (HTML)</label>
            <textarea name="content" id="blogContent" rows="8" class="form-control" required></textarea>
          </div>

          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" name="isPublished" id="blogPublished" checked>
            <label class="form-check-label small fw-medium" for="blogPublished">Is Published</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-danger px-3">Save Story</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openAddBlog() {
    document.getElementById('blogId').value = '';
    document.getElementById('blogModalTitle').innerText = 'Add Blog Article';
    document.getElementById('blogTitle').value = '';
    document.getElementById('blogSlug').value = '';
    document.getElementById('blogAuthor').value = 'CL Editorial';
    document.getElementById('blogTags').value = '';
    document.getElementById('blogExcerpt').value = '';
    document.getElementById('blogContent').value = '';
    document.getElementById('blogPublished').checked = true;
  }

  function openEditBlog(id, title, slug, excerpt, content, author, tags, isPublished) {
    document.getElementById('blogId').value = id;
    document.getElementById('blogModalTitle').innerText = 'Edit Story: ' + title;
    document.getElementById('blogTitle').value = title;
    document.getElementById('blogSlug').value = slug;
    document.getElementById('blogAuthor').value = author;
    document.getElementById('blogTags').value = tags;
    document.getElementById('blogExcerpt').value = excerpt;
    document.getElementById('blogContent').value = content;
    document.getElementById('blogPublished').checked = isPublished;
    new bootstrap.Modal(document.getElementById('blogModal')).show();
  }
</script>
