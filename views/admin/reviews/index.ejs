<!-- Reviews Moderation -->
<div class="container-fluid p-0">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark m-0">Customer Reviews Moderation</h3>
      <p class="text-muted small m-0">Review star ratings, verified buyer badges, and moderate public comments</p>
    </div>
  </div>

  <!-- Filter tabs -->
  <ul class="nav nav-pills bg-white p-2 rounded-3 shadow-sm mb-3 gap-1">
    <li class="nav-item">
      <a class="nav-link py-1 px-3 small fw-medium <%= currentStatus === 'all' ? 'active bg-dark' : 'text-secondary' %>" href="/admin/reviews?status=all">All</a>
    </li>
    <li class="nav-item">
      <a class="nav-link py-1 px-3 small fw-medium <%= currentStatus === 'pending' ? 'active bg-warning text-dark' : 'text-secondary' %>" href="/admin/reviews?status=pending">Pending</a>
    </li>
    <li class="nav-item">
      <a class="nav-link py-1 px-3 small fw-medium <%= currentStatus === 'approved' ? 'active bg-success' : 'text-secondary' %>" href="/admin/reviews?status=approved">Approved</a>
    </li>
    <li class="nav-item">
      <a class="nav-link py-1 px-3 small fw-medium <%= currentStatus === 'rejected' ? 'active bg-danger' : 'text-secondary' %>" href="/admin/reviews?status=rejected">Rejected</a>
    </li>
  </ul>

  <div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small text-secondary">
          <tr>
            <th class="ps-3">Product</th>
            <th>Reviewer</th>
            <th>Rating</th>
            <th>Review Comment</th>
            <th>Date</th>
            <th>Status</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody class="small">
          <% if (reviews && reviews.length) { %>
            <% reviews.forEach(r => { %>
              <tr>
                <td class="ps-3 fw-semibold">
                  <% if (r.product) { %>
                    <a href="/products/<%= r.product.slug %>" target="_blank" class="text-dark text-decoration-none hover-underline">
                      <%= r.product.name %>
                    </a>
                  <% } else { %>
                    <span class="text-muted">Deleted Product</span>
                  <% } %>
                </td>
                <td>
                  <div class="fw-medium"><%= r.name %></div>
                  <% if (r.isVerifiedBuyer) { %>
                    <span class="badge bg-success bg-opacity-10 text-success" style="font-size: 10px;">Verified Buyer</span>
                  <% } %>
                </td>
                <td>
                  <span class="text-warning">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="fa-solid fa-star <%= i <= r.rating ? '' : 'text-muted text-opacity-25' %>"></i>
                    <% } %>
                  </span>
                </td>
                <td style="max-width: 320px;">
                  <strong class="d-block text-dark"><%= r.title || '' %></strong>
                  <span class="text-muted"><%= r.comment %></span>
                </td>
                <td class="text-muted"><%= r.createdAt.toLocaleDateString('en-GB') %></td>
                <td>
                  <span class="badge <%= r.status === 'approved' ? 'bg-success' : r.status === 'pending' ? 'bg-warning text-dark' : 'bg-danger' %>">
                    <%= r.status.toUpperCase() %>
                  </span>
                </td>
                <td class="text-end pe-3">
                  <div class="btn-group btn-group-sm">
                    <% if (r.status !== 'approved') { %>
                      <form action="/admin/reviews/<%= r._id %>/status" method="POST" class="d-inline">
                        <input type="hidden" name="status" value="approved">
                        <button type="submit" class="btn btn-outline-success" title="Approve Review">
                          <i class="fa-solid fa-check"></i>
                        </button>
                      </form>
                    <% } %>
                    <% if (r.status !== 'rejected') { %>
                      <form action="/admin/reviews/<%= r._id %>/status" method="POST" class="d-inline">
                        <input type="hidden" name="status" value="rejected">
                        <button type="submit" class="btn btn-outline-warning" title="Reject / Hide">
                          <i class="fa-solid fa-ban"></i>
                        </button>
                      </form>
                    <% } %>
                    <form action="/admin/reviews/<%= r._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Permanently delete review?')">
                      <button type="submit" class="btn btn-outline-danger" title="Delete">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">No reviews found matching filter.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
