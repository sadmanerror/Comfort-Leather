<!-- Categories Management -->
<div class="container-fluid p-0">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark m-0">Categories Hierarchy</h3>
      <p class="text-muted small m-0">Organize men, women, kids footwear and accessory departments</p>
    </div>
    <button class="btn btn-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#categoryModal" onclick="openAddCategory()">
      <i class="fa-solid fa-plus me-1"></i> Add Category
    </button>
  </div>

  <div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 text-nowrap">
        <thead class="table-light small text-secondary">
          <tr>
            <th class="ps-3">Name</th>
            <th>Slug</th>
            <th>Gender</th>
            <th>Parent Category</th>
            <th>Order</th>
            <th>Status</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody class="small">
          <% if (categories && categories.length) { %>
            <% categories.forEach(c => { %>
              <tr>
                <td class="ps-3 fw-semibold text-dark">
                  <%= c.parent ? '&mdash; ' : '' %><%= c.name %>
                </td>
                <td class="text-muted"><%= c.slug %></td>
                <td><span class="badge bg-light text-dark border"><%= c.gender %></span></td>
                <td><%= c.parent ? c.parent.name : '<span class="text-muted">Root</span>' %></td>
                <td><%= c.displayOrder %></td>
                <td>
                  <span class="badge <%= c.isActive ? 'bg-success' : 'bg-secondary' %>">
                    <%= c.isActive ? 'Active' : 'Hidden' %>
                  </span>
                </td>
                <td class="text-end pe-3">
                  <button type="button" class="btn btn-sm btn-outline-secondary py-1" onclick="openEditCategory('<%= c._id %>', '<%= c.name.replace(/'/g, '\\\'') %>', '<%= c.slug %>', '<%= c.parent ? c.parent._id : '' %>', '<%= c.gender %>', <%= c.displayOrder %>, <%= c.isActive %>)">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                  <form action="/admin/categories/<%= c._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this category? Sub-products might lose reference.')">
                    <button type="submit" class="btn btn-sm btn-outline-danger py-1">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">No categories created yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header">
        <h6 class="modal-title fw-bold" id="catModalTitle">Category Details</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/admin/categories" method="POST">
        <input type="hidden" name="id" id="catId">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Category Name <span class="text-danger">*</span></label>
            <input type="text" name="name" id="catName" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Slug (Optional)</label>
            <input type="text" name="slug" id="catSlug" class="form-control" placeholder="auto-generated">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Department / Gender</label>
            <select name="gender" id="catGender" class="form-select">
              <option value="All">All</option>
              <option value="Men">Men</option>
              <option value="Women">Women</option>
              <option value="Children">Children</option>
              <option value="Accessories">Accessories</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Parent Category (Leave empty if Root)</label>
            <select name="parent" id="catParent" class="form-select">
              <option value="">None (Top-Level Category)</option>
              <% categories.filter(c => !c.parent).forEach(rc => { %>
                <option value="<%= rc._id %>"><%= rc.name %> (<%= rc.gender %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label small fw-semibold">Display Order</label>
              <input type="number" name="displayOrder" id="catOrder" class="form-control" value="0">
            </div>
            <div class="col-6 d-flex align-items-end">
              <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" name="isActive" id="catActive" checked>
                <label class="form-check-label small fw-medium" for="catActive">Is Active</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-danger px-3">Save Category</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openAddCategory() {
    document.getElementById('catId').value = '';
    document.getElementById('catModalTitle').innerText = 'Add Category';
    document.getElementById('catName').value = '';
    document.getElementById('catSlug').value = '';
    document.getElementById('catParent').value = '';
    document.getElementById('catOrder').value = '0';
    document.getElementById('catActive').checked = true;
  }

  function openEditCategory(id, name, slug, parentId, gender, order, isActive) {
    document.getElementById('catId').value = id;
    document.getElementById('catModalTitle').innerText = 'Edit Category: ' + name;
    document.getElementById('catName').value = name;
    document.getElementById('catSlug').value = slug;
    document.getElementById('catParent').value = parentId || '';
    document.getElementById('catGender').value = gender || 'All';
    document.getElementById('catOrder').value = order || 0;
    document.getElementById('catActive').checked = isActive;
    new bootstrap.Modal(document.getElementById('categoryModal')).show();
  }
</script>
