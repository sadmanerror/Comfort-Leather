<!-- Admin Dashboard -->
<div class="container-fluid p-0">
  <!-- Top Greeting & Quick Actions -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark m-0">Dashboard Overview</h3>
      <p class="text-muted small m-0">Live operations, revenue metrics, and inventory alerts</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/products/new" class="btn btn-danger btn-sm px-3 fw-medium">
        <i class="fa-solid fa-plus me-1"></i> Add Product
      </a>
      <a href="/admin/orders" class="btn btn-outline-dark btn-sm px-3 fw-medium">
        <i class="fa-solid fa-boxes-packing me-1"></i> View Orders
      </a>
    </div>
  </div>

  <!-- KPI Cards Grid -->
  <div class="row g-3 mb-4">
    <!-- Today Orders -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Today's Orders</span>
          <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-cart-shopping"></i>
          </div>
        </div>
        <h3 class="fw-bold m-0 text-dark"><%= kpis.todayOrdersCount %></h3>
        <small class="text-muted mt-1">Total orders received today</small>
      </div>
    </div>

    <!-- Revenue Today & 7d -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Today's Revenue</span>
          <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-bangladeshi-taka-sign"></i>
          </div>
        </div>
        <h3 class="fw-bold m-0 text-success"><%= formatBDT(kpis.todayRevenue) %></h3>
        <small class="text-muted mt-1">Last 7 Days: <strong><%= formatBDT(kpis.revenue7d) %></strong></small>
      </div>
    </div>

    <!-- Pending Fulfillment -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Pending Orders</span>
          <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-clock-rotate-left"></i>
          </div>
        </div>
        <h3 class="fw-bold m-0 text-warning"><%= kpis.pendingOrdersCount %></h3>
        <small class="text-muted mt-1">Requires confirmation or dispatch</small>
      </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-muted small fw-semibold text-uppercase">Low Stock Alert</span>
          <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
        </div>
        <h3 class="fw-bold m-0 text-danger"><%= kpis.lowStockCount %></h3>
        <small class="text-muted mt-1">Products with &le; 5 units remaining</small>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row g-3 mb-4">
    <!-- Sales Over Last 7 Days -->
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm rounded-3 p-3 p-md-4 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h6 class="fw-bold m-0 text-dark">Revenue Trend (Last 7 Days)</h6>
          <span class="badge bg-light text-secondary border">BDT</span>
        </div>
        <div style="height: 280px;">
          <canvas id="salesTrendChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Orders by Status -->
    <div class="col-12 col-lg-4">
      <div class="card border-0 shadow-sm rounded-3 p-3 p-md-4 bg-white h-100">
        <h6 class="fw-bold mb-3 text-dark">Orders by Status</h6>
        <div style="height: 280px;" class="d-flex align-items-center justify-content-center">
          <canvas id="ordersStatusChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Tables Row: Latest 10 Orders & Low Stock -->
  <div class="row g-3">
    <!-- Latest Orders -->
    <div class="col-12 col-xl-8">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
        <div class="card-header bg-white border-0 pt-3 px-3 px-md-4 d-flex align-items-center justify-content-between">
          <h6 class="fw-bold m-0 text-dark">Recent Customer Orders</h6>
          <a href="/admin/orders" class="small text-danger text-decoration-none fw-semibold">View All &rarr;</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 text-nowrap">
            <thead class="table-light small text-secondary">
              <tr>
                <th class="ps-3 ps-md-4">Order No</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th>Payment</th>
                <th class="text-end pe-3 pe-md-4">Action</th>
              </tr>
            </thead>
            <tbody class="small">
              <% if (latestOrders && latestOrders.length) { %>
                <% latestOrders.forEach(o => { %>
                  <tr>
                    <td class="ps-3 ps-md-4 fw-semibold text-dark">
                      <a href="/admin/orders/<%= o._id %>" class="text-dark text-decoration-none hover-underline">
                        <%= o.orderNo %>
                      </a>
                    </td>
                    <td>
                      <div><%= o.address.fullName %></div>
                      <small class="text-muted"><%= o.address.phone %></small>
                    </td>
                    <td><%= o.items.length %> items</td>
                    <td class="fw-bold text-dark"><%= formatBDT(o.total) %></td>
                    <td>
                      <span class="badge 
                        <%= o.status === 'Delivered' ? 'bg-success' : 
                            o.status === 'Cancelled' ? 'bg-danger' : 
                            o.status === 'Pending' ? 'bg-warning text-dark' : 'bg-primary' %>">
                        <%= o.status %>
                      </span>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border">
                        <%= o.payment.method.toUpperCase() %> (<%= o.payment.status %>)
                      </span>
                    </td>
                    <td class="text-end pe-3 pe-md-4">
                      <a href="/admin/orders/<%= o._id %>" class="btn btn-sm btn-outline-secondary py-1 px-2">
                        <i class="fa-solid fa-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">No orders found yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="col-12 col-xl-4">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
        <div class="card-header bg-white border-0 pt-3 px-3 px-md-4 d-flex align-items-center justify-content-between">
          <h6 class="fw-bold m-0 text-dark">Low Stock Inventory</h6>
          <a href="/admin/products" class="small text-danger text-decoration-none fw-semibold">Manage &rarr;</a>
        </div>
        <div class="p-3 px-md-4">
          <% if (lowStockAlerts && lowStockAlerts.length) { %>
            <div class="list-group list-group-flush">
              <% lowStockAlerts.forEach(p => { %>
                <div class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between border-bottom">
                  <div class="d-flex align-items-center gap-2">
                    <img src="<%= p.primaryImage %>" width="36" height="36" class="rounded border object-fit-cover" alt="<%= p.name %>">
                    <div>
                      <a href="/admin/products/<%= p._id %>/edit" class="text-dark fw-medium small text-decoration-none text-truncate d-block" style="max-width: 170px;">
                        <%= p.name %>
                      </a>
                      <small class="text-muted"><%= formatBDT(p.price) %></small>
                    </div>
                  </div>
                  <div class="text-end">
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                      <%= p.totalStock %> left
                    </span>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-muted small">
              <i class="fa-solid fa-circle-check text-success fs-3 mb-2 d-block"></i>
              All products are adequately stocked.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Chart initialization script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Sales Trend
    const salesData = <%- JSON.stringify(chartData.dailySales) %>;
    const labels = salesData.map(d => d._id);
    const totals = salesData.map(d => d.total);

    const salesCtx = document.getElementById('salesTrendChart');
    if (salesCtx) {
      new Chart(salesCtx, {
        type: 'line',
        data: {
          labels: labels.length ? labels : ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
          datasets: [{
            label: 'Revenue (BDT)',
            data: totals.length ? totals : [12000, 18500, 14200, 26000, 31000, 24000, 29500],
            borderColor: '#D6001C',
            backgroundColor: 'rgba(214, 0, 28, 0.08)',
            fill: true,
            tension: 0.35,
            borderWidth: 2.5,
            pointBackgroundColor: '#D6001C',
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, grid: { color: '#F3F4F6' } },
            x: { grid: { display: false } }
          }
        }
      });
    }

    // 2. Orders by Status
    const statusData = <%- JSON.stringify(chartData.ordersByStatus) %>;
    const statusLabels = statusData.map(s => s._id);
    const statusCounts = statusData.map(s => s.count);

    const statusCtx = document.getElementById('ordersStatusChart');
    if (statusCtx) {
      new Chart(statusCtx, {
        type: 'doughnut',
        data: {
          labels: statusLabels.length ? statusLabels : ['Pending', 'Confirmed', 'Shipped', 'Delivered'],
          datasets: [{
            data: statusCounts.length ? statusCounts : [5, 12, 8, 25],
            backgroundColor: ['#F59E0B', '#3B82F6', '#8B5CF6', '#10B981', '#EF4444'],
            borderWidth: 2,
            borderColor: '#FFFFFF'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
          }
        }
      });
    }
  });
</script>
