<!-- Order Detail View -->
<div class="container-fluid p-0">
  <!-- Top Navigation & Action Header -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-2">
      <a href="/admin/orders" class="btn btn-sm btn-light border"><i class="fa-solid fa-arrow-left"></i></a>
      <div>
        <h4 class="fw-bold text-dark m-0">Order #<%= order.orderNo %></h4>
        <small class="text-muted">Placed on <%= order.createdAt.toLocaleString('en-GB') %></small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/orders/<%= order._id %>/invoice" target="_blank" class="btn btn-outline-dark btn-sm px-3">
        <i class="fa-solid fa-print me-1"></i> Print Invoice
      </a>
      <a href="/admin/orders/<%= order._id %>/packing-slip" target="_blank" class="btn btn-outline-secondary btn-sm px-3">
        <i class="fa-solid fa-file-lines me-1"></i> Packing Slip
      </a>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column (Order Items, Cost Breakdown, Status History) -->
    <div class="col-12 col-xl-8">
      <!-- Order Items Card -->
      <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
        <h5 class="fw-bold text-dark mb-3">Order Items (<%= order.items.length %>)</h5>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light small text-secondary">
              <tr>
                <th>Product</th>
                <th>Variant</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Total</th>
              </tr>
            </thead>
            <tbody class="small">
              <% order.items.forEach(item => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <img src="<%= item.image || '/img/placeholder-shoe.svg' %>" width="48" height="48" class="rounded border object-fit-cover" alt="<%= item.name %>">
                      <div>
                        <div class="fw-semibold text-dark"><%= item.name %></div>
                        <small class="text-muted">SKU: <%= item.sku || 'N/A' %></small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border">Color: <%= item.color %></span>
                    <span class="badge bg-light text-dark border">Size: <%= item.size %></span>
                  </td>
                  <td class="text-center fw-semibold"><%= item.qty %></td>
                  <td class="text-end"><%= formatBDT(item.price) %></td>
                  <td class="text-end fw-bold text-dark"><%= formatBDT(item.price * item.qty) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Financial Summary -->
        <div class="row justify-content-end mt-4">
          <div class="col-12 col-sm-6">
            <div class="border-top pt-3 small">
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Subtotal:</span>
                <span class="fw-semibold text-dark"><%= formatBDT(order.subtotal) %></span>
              </div>
              <% if (order.discount > 0) { %>
                <div class="d-flex justify-content-between mb-1 text-success">
                  <span>Discount <%= order.coupon ? '(' + order.coupon.code + ')' : '' %>:</span>
                  <span class="fw-semibold">-<%= formatBDT(order.discount) %></span>
                </div>
              <% } %>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Shipping Fee:</span>
                <span class="fw-semibold text-dark"><%= formatBDT(order.shipping) %></span>
              </div>
              <div class="d-flex justify-content-between fs-6 fw-bold border-top pt-2 mt-2">
                <span>Grand Total:</span>
                <span class="text-danger"><%= formatBDT(order.total) %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Status History Timeline -->
      <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
        <h5 class="fw-bold text-dark mb-3">Status Timeline &amp; Audit Log</h5>
        <div class="border-start border-2 border-danger ms-3 ps-3">
          <% if (order.statusHistory && order.statusHistory.length) { %>
            <% order.statusHistory.slice().reverse().forEach(h => { %>
              <div class="position-relative mb-3">
                <div class="position-absolute bg-danger rounded-circle" style="width: 10px; height: 10px; left: -21px; top: 5px;"></div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-light text-dark border fw-bold"><%= h.status %></span>
                  <small class="text-muted"><%= new Date(h.changedAt).toLocaleString('en-GB') %> by <%= h.changedBy %></small>
                </div>
                <p class="small text-secondary m-0 mt-1"><%= h.note || 'No note recorded.' %></p>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-muted small">No history logged.</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Right Column (Customer, Shipping, Payment, Manage Order) -->
    <div class="col-12 col-xl-4">
      <!-- Update Order Status Card -->
      <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
        <h6 class="fw-bold text-dark mb-3">Update Order Status</h6>
        <form action="/admin/orders/<%= order._id %>/status" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Fulfillment Status</label>
            <select name="status" class="form-select">
              <% ['Pending', 'Confirmed', 'Packed', 'Shipped', 'Delivered', 'Cancelled', 'Returned'].forEach(st => { %>
                <option value="<%= st %>" <%= order.status === st ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Timeline Note / Comment</label>
            <input type="text" name="note" class="form-control form-control-sm" placeholder="e.g. Dispatched with Pathao Courier tracking #12345">
          </div>

          <button type="submit" class="btn btn-danger btn-sm w-100 fw-semibold">
            Update Status
          </button>
        </form>
      </div>

      <!-- Payment Management Card -->
      <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
        <h6 class="fw-bold text-dark mb-3">Payment Verification</h6>
        <div class="small mb-3">
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Method:</span>
            <span class="fw-bold text-uppercase"><%= order.payment.method %></span>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Status:</span>
            <span class="badge <%= order.payment.status === 'paid' ? 'bg-success' : 'bg-warning text-dark' %>"><%= order.payment.status.toUpperCase() %></span>
          </div>
          <% if (order.payment.trxId) { %>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Transaction ID:</span>
              <span class="fw-semibold text-dark"><%= order.payment.trxId %></span>
            </div>
          <% } %>
        </div>

        <form action="/admin/orders/<%= order._id %>/status" method="POST">
          <input type="hidden" name="paymentStatus" value="<%= order.payment.status === 'paid' ? 'pending' : 'paid' %>">
          <button type="submit" class="btn <%= order.payment.status === 'paid' ? 'btn-outline-warning' : 'btn-success' %> btn-sm w-100 fw-semibold">
            <i class="fa-solid fa-check-double me-1"></i>
            <%= order.payment.status === 'paid' ? 'Mark as Payment Pending' : 'Mark as Verified & Paid' %>
          </button>
        </form>
      </div>

      <!-- Delivery Address Card -->
      <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
        <h6 class="fw-bold text-dark mb-3">Customer &amp; Delivery Info</h6>
        <div class="small">
          <p class="mb-1 fw-bold text-dark"><%= order.address.fullName %></p>
          <p class="mb-1 text-muted"><i class="fa-solid fa-phone me-1"></i> <%= order.address.phone %></p>
          <% if (order.guestInfo?.email || (order.user && order.user.email)) { %>
            <p class="mb-2 text-muted"><i class="fa-solid fa-envelope me-1"></i> <%= order.guestInfo?.email || order.user.email %></p>
          <% } %>
          <div class="bg-light p-2 rounded border mt-2">
            <strong>Address:</strong><br>
            <%= order.address.addressDetails %><br>
            <%= order.address.area %>, <%= order.address.district %><br>
            <%= order.address.division %> Division
          </div>
          <% if (order.note) { %>
            <div class="mt-2 text-muted fst-italic">
              <strong>Customer Note:</strong> "<%= order.note %>"
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
