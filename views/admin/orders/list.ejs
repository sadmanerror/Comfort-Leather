<!-- Orders Management List -->
<div class="container-fluid p-0">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark m-0">Orders &amp; Fulfillment</h3>
      <p class="text-muted small m-0">Manage customer orders, verify bKash/Nagad payments, and track shipments</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/orders/export" class="btn btn-outline-secondary btn-sm px-3">
        <i class="fa-solid fa-file-csv me-1"></i> Export Orders CSV
      </a>
    </div>
  </div>

  <!-- Status Tabs -->
  <ul class="nav nav-pills bg-white p-2 rounded-3 shadow-sm mb-3 gap-1 overflow-x-auto text-nowrap">
    <li class="nav-item">
      <a class="nav-link py-1 px-3 small fw-medium <%= (!query.status || query.status === 'all') ? 'active bg-dark' : 'text-secondary' %>" href="/admin/orders?status=all">
        All (<%= counts.all || 0 %>)
      </a>
    </li>
    <% ['Pending', 'Confirmed', 'Packed', 'Shipped', 'Delivered', 'Cancelled', 'Returned'].forEach(st => { %>
      <li class="nav-item">
        <a class="nav-link py-1 px-3 small fw-medium <%= query.status === st ? 'active bg-danger' : 'text-secondary' %>" href="/admin/orders?status=<%= st %>">
          <%= st %> (<%= counts[st] || 0 %>)
        </a>
      </li>
    <% }) %>
  </ul>

  <!-- Filter Card -->
  <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-3">
    <form action="/admin/orders" method="GET" class="row g-2 align-items-center">
      <input type="hidden" name="status" value="<%= query.status || 'all' %>">
      <div class="col-12 col-md-5">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" name="search" class="form-control border-start-0" placeholder="Search order number, customer name or phone..." value="<%= query.search || '' %>">
        </div>
      </div>
      <div class="col-6 col-md-3">
        <select name="paymentStatus" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Payment Status (All)</option>
          <option value="pending" <%= query.paymentStatus === 'pending' ? 'selected' : '' %>>Payment Pending</option>
          <option value="paid" <%= query.paymentStatus === 'paid' ? 'selected' : '' %>>Paid</option>
          <option value="failed" <%= query.paymentStatus === 'failed' ? 'selected' : '' %>>Failed</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
      </div>
    </form>
  </div>

  <!-- Orders Table -->
  <div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 text-nowrap">
        <thead class="table-light small text-secondary">
          <tr>
            <th class="ps-3">Order Number</th>
            <th>Date</th>
            <th>Customer &amp; Phone</th>
            <th>Items</th>
            <th>Total Amount</th>
            <th>Payment Method</th>
            <th>Status</th>
            <th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody class="small">
          <% if (orders && orders.length) { %>
            <% orders.forEach(o => { %>
              <tr>
                <td class="ps-3 fw-bold text-dark">
                  <a href="/admin/orders/<%= o._id %>" class="text-dark text-decoration-none hover-underline">
                    <%= o.orderNo %>
                  </a>
                </td>
                <td class="text-muted"><%= o.createdAt.toLocaleDateString('en-GB') %></td>
                <td>
                  <div class="fw-medium text-dark"><%= o.address.fullName %></div>
                  <small class="text-muted"><%= o.address.phone %></small>
                </td>
                <td><%= o.items.length %> items</td>
                <td class="fw-bold text-dark"><%= formatBDT(o.total) %></td>
                <td>
                  <span class="badge <%= o.payment.status === 'paid' ? 'bg-success bg-opacity-10 text-success border border-success' : 'bg-warning bg-opacity-10 text-warning border border-warning' %>">
                    <%= o.payment.method.toUpperCase() %> &bull; <%= o.payment.status.toUpperCase() %>
                  </span>
                  <% if (o.payment.trxId) { %>
                    <small class="d-block text-muted" style="font-size: 11px;">Trx: <%= o.payment.trxId %></small>
                  <% } %>
                </td>
                <td>
                  <span class="badge 
                    <%= o.status === 'Delivered' ? 'bg-success' : 
                        o.status === 'Cancelled' ? 'bg-danger' : 
                        o.status === 'Pending' ? 'bg-warning text-dark' : 'bg-primary' %>">
                    <%= o.status %>
                  </span>
                </td>
                <td class="text-end pe-3">
                  <a href="/admin/orders/<%= o._id %>" class="btn btn-sm btn-outline-dark py-1 px-2" title="View Order Details">
                    <i class="fa-solid fa-eye me-1"></i> Manage
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="fa-solid fa-receipt fs-2 mb-2 d-block"></i>
                No orders found in this category.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
      <div class="p-3 border-top d-flex align-items-center justify-content-between">
        <small class="text-muted">Showing page <%= page %> of <%= pages %></small>
        <ul class="pagination pagination-sm m-0">
          <% for (let i = 1; i <= pages; i++) { %>
            <li class="page-item <%= page === i ? 'active' : '' %>">
              <a class="page-link" href="/admin/orders?page=<%= i %>&status=<%= query.status || 'all' %>&search=<%= query.search || '' %>"><%= i %></a>
            </li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </div>
</div>
