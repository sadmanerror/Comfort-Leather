<div class="container py-4 py-lg-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb tw-text-sm tw-mb-0">
      <li class="breadcrumb-item"><a href="/" class="tw-text-neutral-500 hover:tw-text-primary-600">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Search Results</li>
    </ol>
  </nav>

  <!-- Search Header & Refine Input -->
  <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm p-4 mb-5">
    <form action="/search" method="GET" class="row g-2 align-items-center">
      <div class="col-md-9 col-lg-10">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 tw-text-neutral-400">
            <i class="bi bi-search"></i>
          </span>
          <input type="text" name="q" class="form-control border-start-0 ps-0" placeholder="Search by shoe style, leather type, brand or color..." value="<%= queryStr %>">
        </div>
      </div>
      <div class="col-md-3 col-lg-2">
        <button type="submit" class="btn btn-primary w-100 tw-rounded-xl tw-font-bold">
          Search
        </button>
      </div>
    </form>
  </div>

  <div class="d-flex justify-content-between align-items-baseline mb-4 flex-wrap gap-2">
    <div>
      <h1 class="tw-font-display tw-font-bold tw-text-2xl lg:tw-text-3xl tw-text-neutral-900 mb-1">
        <% if (queryStr) { %>
          Results for "<%= queryStr %>"
        <% } else { %>
          Search Footwear
        <% } %>
      </h1>
      <p class="tw-text-sm tw-text-neutral-500 mb-0">
        <%= total %> <%= total === 1 ? 'product' : 'products' %> found in our collection
      </p>
    </div>
  </div>

  <% if (products && products.length > 0) { %>
    <!-- Products Grid -->
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4 mb-5">
      <% products.forEach(product => { %>
        <div class="col">
          <%- include('../partials/product-card', { product }) %>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (pages > 1) { %>
      <nav aria-label="Search pagination" class="d-flex justify-content-center mt-5">
        <ul class="pagination">
          <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/search?q=<%= encodeURIComponent(queryStr) %>&page=<%= page - 1 %>">Previous</a>
          </li>
          <% for (let i = 1; i <= pages; i++) { %>
            <li class="page-item <%= page === i ? 'active' : '' %>">
              <a class="page-link" href="/search?q=<%= encodeURIComponent(queryStr) %>&page=<%= i %>"><%= i %></a>
            </li>
          <% } %>
          <li class="page-item <%= page >= pages ? 'disabled' : '' %>">
            <a class="page-link" href="/search?q=<%= encodeURIComponent(queryStr) %>&page=<%= page + 1 %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>
  <% } else { %>
    <!-- No Results State -->
    <div class="text-center py-5">
      <div class="tw-w-20 tw-h-20 tw-rounded-full tw-bg-neutral-100 tw-text-neutral-400 d-inline-flex align-items-center justify-content-center mb-3">
        <i class="bi bi-search tw-text-3xl"></i>
      </div>
      <h2 class="tw-font-display tw-font-bold tw-text-xl tw-text-neutral-800 mb-2">No shoes found matching your search</h2>
      <p class="tw-text-neutral-500 tw-text-sm tw-max-w-md mx-auto mb-4">
        Try checking your spelling, using broader terms, or explore our top categories below:
      </p>

      <!-- Suggested Category Pills -->
      <div class="d-flex justify-content-center gap-2 flex-wrap tw-max-w-xl mx-auto mb-5">
        <a href="/search?q=Oxford" class="btn btn-sm btn-outline-secondary tw-rounded-full">Men's Oxford</a>
        <a href="/search?q=Sneaker" class="btn btn-sm btn-outline-secondary tw-rounded-full">Athletic Sneakers</a>
        <a href="/search?q=Loafer" class="btn btn-sm btn-outline-secondary tw-rounded-full">Leather Loafers</a>
        <a href="/search?q=Sandals" class="btn btn-sm btn-outline-secondary tw-rounded-full">Comfort Sandals</a>
        <a href="/search?q=Heels" class="btn btn-sm btn-outline-secondary tw-rounded-full">Women's Heels</a>
        <a href="/search?q=School" class="btn btn-sm btn-outline-secondary tw-rounded-full">School Shoes</a>
      </div>

      <a href="/collections/all" class="btn btn-primary tw-rounded-xl px-4 py-2">
        Browse All Footwear
      </a>
    </div>
  <% } %>
</div>
