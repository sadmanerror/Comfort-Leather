<div class="container py-4 py-lg-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb tw-text-sm tw-mb-0">
      <li class="breadcrumb-item"><a href="/" class="tw-text-neutral-500 hover:tw-text-primary-600">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Store Locator</li>
    </ol>
  </nav>

  <!-- Hero Header -->
  <div class="text-center tw-max-w-2xl mx-auto mb-5">
    <h1 class="tw-font-display tw-font-extrabold tw-text-3xl lg:tw-text-4xl tw-text-neutral-900 mb-2">Find a StepUp Store Near You</h1>
    <p class="tw-text-neutral-500 tw-text-sm md:tw-text-base mb-4">
      Experience our premium leather footwear in person. Try sizes, explore exclusive store-only editions, or visit our exchange counters nationwide.
    </p>

    <!-- City Filter Pills -->
    <div class="d-flex justify-content-center gap-2 flex-wrap">
      <a href="/stores?city=all" class="btn btn-sm <%= currentCity === 'all' ? 'btn-primary' : 'btn-outline-dark' %> tw-rounded-full px-3">
        All Outlets (<%= stores ? stores.length : 0 %>)
      </a>
      <% if (allCities && allCities.length > 0) { %>
        <% allCities.forEach(city => { %>
          <a href="/stores?city=<%= encodeURIComponent(city) %>" class="btn btn-sm <%= currentCity === city ? 'btn-primary' : 'btn-outline-dark' %> tw-rounded-full px-3">
            <%= city %>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Store Search Filter -->
  <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm p-3 mb-5 tw-max-w-md mx-auto">
    <div class="input-group">
      <span class="input-group-text bg-white border-end-0 tw-text-neutral-400">
        <i class="bi bi-search"></i>
      </span>
      <input type="text" id="storeFilterInput" class="form-control border-start-0 ps-0" placeholder="Filter by store name or area..." onkeyup="filterStoreCards()">
    </div>
  </div>

  <!-- Stores Grid -->
  <% if (stores && stores.length > 0) { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="storeCardsGrid">
      <% stores.forEach(store => { %>
        <div class="col store-card-col" data-search="<%= (store.name + ' ' + store.address + ' ' + store.city).toLowerCase() %>">
          <div class="card h-100 tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm overflow-hidden hover:tw-shadow-md tw-transition-all">
            <div class="card-body p-4 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-primary-subtle text-primary tw-rounded-lg py-1 px-2.5 tw-text-xs font-semibold">
                  <%= store.city %>
                </span>
                <span class="tw-text-xs text-success d-flex align-items-center gap-1">
                  <i class="bi bi-circle-fill tw-text-2xs"></i> Open Today
                </span>
              </div>

              <h2 class="tw-font-bold tw-text-base tw-text-neutral-900 mb-2">
                <%= store.name %>
              </h2>

              <p class="tw-text-xs tw-text-neutral-600 mb-3 flex-grow-1">
                <i class="bi bi-geo-alt text-danger me-1"></i> <%= store.address %>
              </p>

              <div class="tw-text-xs tw-space-y-1.5 tw-text-neutral-500 mb-4 pt-3 border-top">
                <div>
                  <i class="bi bi-telephone text-primary me-1"></i> Phone: 
                  <a href="tel:<%= store.phone %>" class="tw-text-neutral-700 tw-font-semibold hover:tw-text-primary-600 tw-no-underline">
                    <%= store.phone %>
                  </a>
                </div>
                <div>
                  <i class="bi bi-clock text-amber-500 me-1"></i> Hours: 
                  <span class="tw-text-neutral-700"><%= store.openingHours || '10:00 AM - 09:30 PM (Daily)' %></span>
                </div>
              </div>

              <div class="d-flex gap-2 mt-auto">
                <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(store.name + ' ' + store.address) %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark btn-sm flex-grow-1 tw-rounded-xl">
                  <i class="bi bi-map me-1"></i> Google Maps
                </a>
                <a href="tel:<%= store.phone %>" class="btn btn-primary btn-sm px-3 tw-rounded-xl">
                  <i class="bi bi-telephone"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <i class="bi bi-geo-alt tw-text-4xl text-neutral-300 d-block mb-2"></i>
      <h3 class="tw-font-bold tw-text-base text-neutral-700">No stores found in this location</h3>
      <p class="tw-text-xs text-neutral-500">Please choose "All Outlets" to see all available stores across Bangladesh.</p>
    </div>
  <% } %>
</div>

<script>
  function filterStoreCards() {
    const input = document.getElementById('storeFilterInput').value.toLowerCase();
    const cols = document.querySelectorAll('.store-card-col');
    cols.forEach(col => {
      const searchStr = col.getAttribute('data-search') || '';
      if (searchStr.includes(input)) {
        col.style.display = '';
      } else {
        col.style.display = 'none';
      }
    });
  }
</script>
