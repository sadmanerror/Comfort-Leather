<div class="container py-4 py-lg-5">
  <div class="tw-max-w-3xl mx-auto">
    <!-- Success Banner -->
    <div class="card tw-border-green-200 tw-bg-green-50/50 tw-rounded-3xl p-4 p-md-5 text-center mb-4 tw-shadow-sm">
      <div class="tw-w-20 tw-h-20 tw-rounded-full tw-bg-green-100 tw-text-green-600 d-inline-flex align-items-center justify-content-center mb-3">
        <i class="bi bi-check-circle-fill tw-text-4xl"></i>
      </div>
      <h1 class="tw-font-display tw-font-extrabold tw-text-2xl md:tw-text-3xl tw-text-neutral-900 mb-2">Order Confirmed!</h1>
      <p class="tw-text-neutral-600 tw-text-sm md:tw-text-base tw-max-w-md mx-auto mb-3">
        Thank you, <strong><%= order.address.fullName %></strong>! We have received your order and are preparing your shoes for dispatch.
      </p>
      <div class="d-inline-flex align-items-center gap-2 tw-bg-white tw-border tw-border-green-200 tw-rounded-full px-4 py-1.5 tw-shadow-xs">
        <span class="tw-text-xs tw-text-neutral-500">Order Reference:</span>
        <strong class="tw-font-mono tw-text-primary-700 tw-text-sm">#<%= order.orderNo %></strong>
      </div>
    </div>

    <!-- Order Summary Card -->
    <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm overflow-hidden mb-4">
      <div class="card-header bg-white py-3 px-4 tw-border-b tw-border-neutral-200 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <span class="tw-text-xs tw-text-neutral-500 d-block">Placed on</span>
          <strong class="tw-text-sm tw-text-neutral-800"><%= new Date(order.createdAt).toLocaleDateString('en-BD', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-primary-subtle text-primary py-2 px-3 tw-rounded-lg tw-font-semibold">
            Status: <%= order.status %>
          </span>
          <button class="btn btn-sm btn-outline-dark tw-rounded-lg d-print-none" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Receipt
          </button>
        </div>
      </div>

      <!-- Items List -->
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="bg-light tw-text-xs tw-uppercase tw-text-neutral-500">
              <tr>
                <th class="ps-4 py-3">Item Details</th>
                <th class="py-3 text-center">Qty</th>
                <th class="py-3 text-end pe-4">Price</th>
              </tr>
            </thead>
            <tbody class="tw-divide-y tw-divide-neutral-100">
              <% order.items.forEach(item => { %>
                <tr>
                  <td class="ps-4 py-3">
                    <div class="d-flex align-items-center gap-3">
                      <img src="<%= item.image || '/img/placeholder-shoe.svg' %>" alt="<%= item.name %>" class="tw-w-14 tw-h-14 tw-rounded-xl tw-object-cover tw-bg-neutral-100 flex-shrink-0">
                      <div>
                        <div class="tw-font-semibold tw-text-neutral-900 tw-text-sm"><%= item.name %></div>
                        <div class="tw-text-xs tw-text-neutral-500 mt-0.5">
                          Color: <strong><%= item.color %></strong> | Size: <strong><%= item.size %></strong>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="text-center py-3 tw-text-sm tw-font-medium text-neutral-700">
                    <%= item.qty %>
                  </td>
                  <td class="text-end pe-4 py-3 tw-font-bold tw-text-neutral-900 tw-text-sm">
                    <%= formatBDT(item.price * item.qty) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Totals Calculation -->
        <div class="p-4 bg-light tw-border-t tw-border-neutral-200">
          <div class="tw-max-w-xs ms-auto tw-space-y-2 tw-text-sm">
            <div class="d-flex justify-content-between text-neutral-600">
              <span>Subtotal:</span>
              <span class="tw-font-semibold text-neutral-900"><%= formatBDT(order.subtotal) %></span>
            </div>
            <% if (order.discount > 0) { %>
              <div class="d-flex justify-content-between text-success">
                <span>Discount:</span>
                <span class="tw-font-semibold">-<%= formatBDT(order.discount) %></span>
              </div>
            <% } %>
            <div class="d-flex justify-content-between text-neutral-600">
              <span>Delivery Fee:</span>
              <span class="tw-font-semibold text-neutral-900"><%= order.shipping === 0 ? 'FREE' : formatBDT(order.shipping) %></span>
            </div>
            <div class="d-flex justify-content-between tw-text-base tw-font-bold text-neutral-900 pt-2 border-top">
              <span>Total Paid / Payable:</span>
              <span class="tw-font-display tw-text-primary-700 tw-text-xl"><%= formatBDT(order.total) %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Details Grid -->
    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="card h-100 tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm p-4">
          <h3 class="tw-font-bold tw-text-sm tw-text-neutral-900 mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-geo-alt-fill text-danger"></i> Shipping Address
          </h3>
          <div class="tw-text-sm text-neutral-700 tw-space-y-1">
            <div class="tw-font-bold text-neutral-900"><%= order.address.fullName %></div>
            <div><%= order.address.addressDetails %></div>
            <div><%= order.address.area %>, <%= order.address.district %>, <%= order.address.division %></div>
            <div class="pt-2 text-neutral-500">Phone: <strong>+880 <%= order.address.phone %></strong></div>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card h-100 tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm p-4">
          <h3 class="tw-font-bold tw-text-sm tw-text-neutral-900 mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-credit-card text-primary"></i> Payment & Delivery
          </h3>
          <div class="tw-text-sm text-neutral-700 tw-space-y-2">
            <div>
              <span class="text-neutral-500">Method:</span>
              <strong class="text-uppercase ms-1">
                <%= order.payment.method === 'cod' ? 'Cash on Delivery (COD)' : 'bKash / Nagad' %>
              </strong>
            </div>
            <% if (order.payment.trxId) { %>
              <div>
                <span class="text-neutral-500">TrxID:</span>
                <span class="tw-font-mono font-bold ms-1"><%= order.payment.trxId %></span>
              </div>
            <% } %>
            <div>
              <span class="text-neutral-500">Estimated Delivery:</span>
              <strong class="text-success ms-1">
                <%= order.address.division.toLowerCase() === 'dhaka' ? '24 - 48 Hours' : '3 - 5 Business Days' %>
              </strong>
            </div>
            <% if (order.note) { %>
              <div class="pt-2 border-top text-xs text-neutral-500">
                <em>Note: "<%= order.note %>"</em>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions Footer -->
    <div class="d-flex justify-content-center gap-3 flex-wrap d-print-none">
      <a href="/track-order?orderNo=<%= order.orderNo %>&phone=<%= order.address.phone %>" class="btn btn-dark tw-rounded-xl px-4 py-2.5">
        <i class="bi bi-geo-alt me-1"></i> Track Order Status
      </a>
      <a href="/collections/all" class="btn btn-outline-dark tw-rounded-xl px-4 py-2.5">
        Continue Shopping
      </a>
    </div>
  </div>
</div>
