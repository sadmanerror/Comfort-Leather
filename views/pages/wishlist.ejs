<div class="container py-4 py-lg-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb tw-text-sm tw-mb-0">
      <li class="breadcrumb-item"><a href="/" class="tw-text-neutral-500 hover:tw-text-primary-600">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">My Wishlist</li>
    </ol>
  </nav>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="tw-font-display tw-font-bold tw-text-2xl lg:tw-text-3xl tw-text-neutral-900 mb-1">My Wishlist</h1>
      <p class="tw-text-sm tw-text-neutral-500 mb-0">Saved shoes and styles you love</p>
    </div>
  </div>

  <!-- Server rendered products (if logged in) or client container -->
  <div id="wishlistContainer">
    <% if (products && products.length > 0) { %>
      <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4" id="serverWishlistGrid">
        <% products.forEach(product => { %>
          <div class="col" id="wishlist-item-<%= product._id %>">
            <div class="card h-100 tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm overflow-hidden d-flex flex-column">
              <div class="position-relative">
                <a href="/products/<%= product.slug %>">
                  <img src="<%= product.primaryImage || '/img/placeholder-shoe.svg' %>" alt="<%= product.name %>" class="w-100 tw-aspect-square tw-object-cover tw-bg-neutral-100">
                </a>
                <button type="button" class="btn btn-sm btn-light position-absolute top-0 end-0 m-2 tw-rounded-full tw-shadow-sm text-danger" onclick="removeFromWishlistServer('<%= product._id %>')">
                  <i class="bi bi-x-lg"></i>
                </button>
                <% if (product.isOnSale && product.discountPercent > 0) { %>
                  <span class="badge bg-danger position-absolute top-0 start-0 m-2 tw-rounded-lg">
                    -<%= product.discountPercent %>%
                  </span>
                <% } %>
              </div>
              <div class="card-body p-3 d-flex flex-column flex-grow-1">
                <div class="tw-text-xs tw-text-neutral-400 tw-uppercase tw-font-bold mb-1">
                  <%= product.brand ? product.brand.name : 'StepUp' %>
                </div>
                <h3 class="tw-font-bold tw-text-sm tw-text-neutral-900 mb-2 line-clamp-1">
                  <a href="/products/<%= product.slug %>" class="tw-text-inherit tw-no-underline hover:tw-text-primary-600">
                    <%= product.name %>
                  </a>
                </h3>
                <div class="mt-auto pt-2">
                  <div class="d-flex align-items-baseline gap-2 mb-3">
                    <span class="tw-font-bold tw-text-sm tw-text-neutral-900">
                      <%= formatBDT(product.isOnSale ? product.salePrice : product.price) %>
                    </span>
                    <% if (product.isOnSale) { %>
                      <span class="tw-text-xs tw-text-neutral-400 text-decoration-line-through">
                        <%= formatBDT(product.price) %>
                      </span>
                    <% } %>
                  </div>
                  <a href="/products/<%= product.slug %>" class="btn btn-primary btn-sm w-100 tw-rounded-xl tw-font-bold">
                    View & Select Size
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <!-- Client side empty/guest state -->
      <div id="wishlistEmptyState" class="text-center py-5">
        <div class="tw-w-20 tw-h-20 tw-rounded-full tw-bg-pink-50 tw-text-pink-500 d-inline-flex align-items-center justify-content-center mb-3">
          <i class="bi bi-heart tw-text-3xl"></i>
        </div>
        <h2 class="tw-font-display tw-font-bold tw-text-xl tw-text-neutral-900 mb-2">Your Wishlist is Empty</h2>
        <p class="tw-text-neutral-500 tw-text-sm tw-max-w-md mx-auto mb-4">
          Tap the heart icon on any shoe to save it to your wishlist. You can review them anytime and add to cart when ready!
        </p>
        <a href="/collections/all" class="btn btn-primary tw-rounded-xl px-4 py-2">
          Discover Shoes
        </a>
      </div>
    <% } %>
  </div>
</div>

<script>
  async function removeFromWishlistServer(productId) {
    try {
      const res = await fetch('/api/wishlist/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId })
      });
      const data = await res.json();
      if (data.success) {
        const el = document.getElementById(`wishlist-item-${productId}`);
        if (el) el.remove();

        // Also remove from local wishlist
        if (window.WishlistState) {
          const idx = window.WishlistState.indexOf(productId);
          if (idx > -1) window.WishlistState.splice(idx, 1);
          localStorage.setItem('stepup_wishlist', JSON.stringify(window.WishlistState));
        }

        const remaining = document.querySelectorAll('#serverWishlistGrid > div');
        if (remaining.length === 0) {
          location.reload();
        }
      }
    } catch (err) {
      console.error(err);
    }
  }
</script>
