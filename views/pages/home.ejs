<!-- 11. Instagram Strip (Grid of 6 Images) -->
<section class="py-5 bg-white border-top">
  <div class="container">
    <div class="text-center mb-4">
      <h5 class="fw-bold m-0 text-dark"><i class="fa-brands fa-instagram text-danger me-2"></i>Follow Us @ComfortLeatherBD</h5>
      <p class="text-muted small m-0">Tag your shoe moments with #ComfortLeatherBD to be featured</p>
    </div>

    <div class="row g-2">
      <% (instagramPosts || []).slice(0, 6).forEach((insta, i) => { %>
        <div class="col-4 col-md-2">
          <a href="<%= insta.postUrl || 'https://instagram.com' %>" target="_blank" class="d-block overflow-hidden rounded position-relative group">
            <div class="bg-light d-flex align-items-center justify-content-center text-secondary" style="aspect-ratio: 1/1;">
              <i class="fa-brands fa-instagram fs-3 opacity-50"></i>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Dynamic Just Landed AJAX Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('#justLandedTabs button');
    const grid = document.getElementById('justLandedGrid');

    tabs.forEach(btn => {
      btn.addEventListener('click', async () => {
        tabs.forEach(b => b.classList.remove('active', 'btn-danger'));
        btn.classList.add('active');

        const cat = btn.dataset.cat;
        try {
          const url = cat ? `/api/products?tag=just-landed&category=${cat}` : '/api/products?tag=just-landed';
          const res = await fetch(url);
          const data = await res.json();

          if (data.products && data.products.length > 0) {
            grid.innerHTML = data.products.map(p => `
              <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-3 product-card bg-white position-relative overflow-hidden">
                  <div class="product-card-media rounded-top position-relative overflow-hidden bg-light">
                    ${p.isOnSale ? `<div class="position-absolute top-0 start-0 m-2 z-2"><span class="badge bg-danger fw-bold">-${p.discountPercent}% SALE</span></div>` : ''}
                    <button type="button" class="btn btn-sm btn-light rounded-circle position-absolute top-0 end-0 m-2 z-2 shadow-sm wishlist-btn border-0 d-flex align-items-center justify-content-center" data-product-id="${p._id}" style="width: 34px; height: 34px;">
                      <i class="fa-regular fa-heart text-danger"></i>
                    </button>
                    <a href="/products/${p.slug}" class="d-block w-100 h-100">
                      <img src="${p.primaryImage}" alt="${p.name}" class="primary-img w-100 h-100 object-fit-cover" loading="lazy">
                      <img src="${p.hoverImage}" alt="${p.name}" class="hover-img w-100 h-100 object-fit-cover" loading="lazy">
                    </a>
                  </div>
                  <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                      <small class="text-uppercase text-secondary fw-semibold d-block mb-1" style="font-size: 11px;">${p.brand ? p.brand.name : ''}</small>
                      <h6 class="card-title fw-semibold mb-2">
                        <a href="/products/${p.slug}" class="text-dark text-decoration-none hover-danger tw-line-clamp-2" style="font-size: 14px;">${p.name}</a>
                      </h6>
                      <div class="d-flex align-items-center gap-2 mb-1">
                        ${p.isOnSale ? `<span class="text-muted text-decoration-line-through small">${p.priceFormatted}</span><span class="fw-bold text-danger fs-6">${p.salePriceFormatted}</span>` : `<span class="fw-bold text-dark fs-6">${p.priceFormatted}</span>`}
                      </div>
                    </div>
                    <div class="mt-2">
                      <a href="/products/${p.slug}" class="btn btn-dark btn-sm w-100 fw-semibold text-uppercase py-1" style="font-size: 12px;">Shop Now</a>
                    </div>
                  </div>
                </div>
              </div>
            `).join('');
          } else {
            grid.innerHTML = '<div class="col-12 text-center text-muted py-5">No products found in this category.</div>';
          }
        } catch (err) {
          console.error('Failed to switch tabs', err);
        }
      });
    });
  });
</script>
