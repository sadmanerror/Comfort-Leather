<!-- 10. Recent Blog Posts -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="d-flex align-items-end justify-content-between mb-4">
      <div>
        <span class="text-danger small fw-bold text-uppercase tracking-wider">Editorial Stories</span>
