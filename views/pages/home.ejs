</section>

<!-- 5. Best Seller Product Carousel (4 Per View Desktop, 2 Mobile) -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="d-flex align-items-end justify-content-between mb-4">
      <div>
        <span class="text-danger small fw-bold text-uppercase tracking-wider">Top Rated</span>
