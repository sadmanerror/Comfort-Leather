          <span class="badge bg-danger text-uppercase px-2 py-1 mb-2">Artisan Craft</span>
          <h2 class="fw-bold mb-2 text-white"><%= accessoriesBanner.title %></h2>
          <p class="text-white-50 small mb-3"><%= accessoriesBanner.subtitle %></p>
          <a href="<%= accessoriesBanner.link %>" class="btn btn-danger btn-sm px-4 py-2 text-uppercase fw-bold rounded-0">
            <%= accessoriesBanner.buttonText %> <i class="fa-solid fa-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
      <div class="position-absolute end-0 top-0 bottom-0 d-none d-md-flex align-items-center pe-5 opacity-25">
        <i class="fa-solid fa-bag-shopping" style="font-size: 160px;"></i>
      </div>
    </div>
  </div>
</section>

<!-- 4. Voucher / Gift-Card Strip Banner -->
<section class="voucher-strip-section py-3">
  <div class="container">
    <div class="bg-danger text-white rounded-3 p-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-sm">
