<!-- 5. STOREFRONT: HOME PAGE (Exact Section Order from Prompt) -->

<!-- 1. Hero Slider (Bootstrap Carousel, Autoplay 5s, Pause on Hover, Dots + Arrows) -->
<section class="hero-slider-section position-relative">
  <div id="homeHeroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000" data-bs-pause="hover">
    <!-- Carousel Indicators (Dots) -->
    <div class="carousel-indicators mb-3">
      <% (heroBanners || []).forEach((banner, idx) => { %>
        <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="<%= idx %>" 
          class="<%= idx === 0 ? 'active' : '' %> rounded-circle" style="width: 12px; height: 12px;" aria-label="Slide <%= idx + 1 %>"></button>
      <% }) %>
    </div>

    <!-- Carousel Slides -->
    <div class="carousel-inner">
      <% if (heroBanners && heroBanners.length) { %>
        <% heroBanners.forEach((banner, idx) => { %>
          <div class="carousel-item <%= idx === 0 ? 'active' : '' %> position-relative" style="background-color: #111111; min-height: 480px;">
            <% if (banner.videoUrl) { %>
              <video src="<%= banner.videoUrl %>" autoplay muted loop playsinline preload="none" 
                class="d-block w-100 object-fit-cover position-absolute top-0 start-0 h-100 opacity-75"></video>
            <% } else { %>
              <picture>
                <% if (banner.mobileImage) { %>
                  <source media="(max-width: 576px)" srcset="<%= banner.mobileImage %>">
                <% } %>
                <img src="<%= banner.desktopImage || '/img/placeholder-shoe.svg' %>" class="d-block w-100 object-fit-cover" 
                  style="max-height: 640px; min-height: 420px; filter: brightness(0.85);" alt="<%= banner.title || 'Slide' %>">
              </picture>
            <% } %>

            <!-- Overlay Content -->
            <div class="carousel-caption text-start d-flex flex-column justify-content-center h-100 top-0 bottom-0 start-0 end-0 px-4 px-md-5">
              <div class="container">
                <div class="col-12 col-md-8 col-lg-6">
                  <% if (banner.subtitle) { %>
                    <span class="badge bg-danger text-uppercase tracking-wider mb-2 px-3 py-2 fw-semibold" style="font-size: 11px;">
                      <%= banner.subtitle %>
                    </span>
                  <% } %>
                  <h1 class="display-4 fw-bold text-white mb-3" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
                    <%= banner.title || 'Step Up Your Everyday Style' %>
                  </h1>
                  <a href="<%= banner.link || '/collections/all' %>" class="btn btn-danger btn-lg px-4 py-2 rounded-0 fw-bold text-uppercase tracking-wider shadow">
                    <%= banner.buttonText || 'Shop Now' %> <i class="fa-solid fa-arrow-right ms-2"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="carousel-item active bg-dark text-white p-5 text-center min-vh-50 d-flex align-items-center justify-content-center">
          <div>
            <h1 class="display-4 fw-bold">Comfort Leather Bangladesh</h1>
            <p class="lead">Handcrafted Leather &amp; Premium Sneakers</p>
            <a href="/collections/all" class="btn btn-danger rounded-0 px-4 py-2 text-uppercase">Shop Collection</a>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Carousel Controls (Arrows) -->
    <button class="carousel-control-prev" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon rounded-circle p-3 bg-dark bg-opacity-50" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon rounded-circle p-3 bg-dark bg-opacity-50" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
</section>

<!-- 2. Gender Category Tiles (Men / Women / Kids - 3 Large Image Cards with Overlay) -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="row g-4">
      <% (genderCategories || []).forEach(cat => { %>
        <div class="col-12 col-md-4">
          <div class="position-relative overflow-hidden rounded-3 shadow-sm group hover-shadow transition-all" style="height: 380px; background-color: #F3F4F6;">
            <div class="w-100 h-100 position-absolute top-0 start-0 d-flex align-items-center justify-content-center bg-dark bg-opacity-10">
              <i class="fa-solid fa-shoe-prints text-muted opacity-25" style="font-size: 96px;"></i>
            </div>
            <!-- Overlay Gradient & Title -->
            <div class="position-absolute bottom-0 start-0 w-100 p-4 text-white" 
              style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 70%, transparent 100%);">
              <span class="text-uppercase small tracking-wider text-danger fw-bold"><%= cat.subtitle %></span>
              <h3 class="fw-bold m-0 mb-3"><%= cat.name %></h3>
              <a href="/collections/<%= cat.slug %>" class="btn btn-outline-light btn-sm text-uppercase fw-semibold px-4 rounded-0">
                Explore <%= cat.name %> &rarr;
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- 3. Accessories Banner (Full-Width Image Link) -->
<section class="accessories-banner-section py-3">
  <div class="container">
    <div class="card border-0 rounded-4 overflow-hidden text-white shadow position-relative" style="background: linear-gradient(135deg, #1A1A1A 0%, #2D3748 100%); min-height: 220px;">
