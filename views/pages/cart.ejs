<div class="container py-4 py-lg-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb tw-text-sm tw-mb-0">
      <li class="breadcrumb-item"><a href="/" class="tw-text-neutral-500 hover:tw-text-primary-600">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Shopping Cart</li>
    </ol>
  </nav>

  <h1 class="tw-font-display tw-font-bold tw-text-2xl lg:tw-text-3xl tw-text-neutral-900 tw-mb-6">Shopping Cart</h1>

  <!-- Cart Container (Populated via client-side CartEngine) -->
  <div id="cartViewContainer">
    <!-- Active Cart Layout -->
    <div id="cartActiveState" class="row g-4 d-none">
      <!-- Cart Items Table / List -->
      <div class="col-lg-8">
        <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm overflow-hidden mb-4">
          <div class="card-header bg-white py-3 px-4 tw-border-b tw-border-neutral-200 d-flex justify-content-between align-items-center">
            <span class="tw-font-semibold tw-text-neutral-800" id="cartItemsCountText">Cart Items</span>
            <button type="button" class="btn btn-sm btn-link tw-text-red-500 hover:tw-text-red-700 tw-no-underline p-0" onclick="clearFullCart()">
              <i class="bi bi-trash3 me-1"></i> Clear Cart
            </button>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table align-middle mb-0" id="cartTable">
                <thead class="bg-light tw-text-xs tw-uppercase tw-text-neutral-500">
                  <tr>
                    <th class="ps-4 py-3">Product</th>
                    <th class="py-3 text-center">Unit Price</th>
                    <th class="py-3 text-center">Quantity</th>
                    <th class="py-3 text-end pe-4">Subtotal</th>
                  </tr>
                </thead>
                <tbody id="cartTableBody" class="tw-divide-y tw-divide-neutral-100">
                  <!-- Dynamically rendered -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Shipping & Delivery Note Banner -->
        <div class="tw-bg-amber-50 tw-border tw-border-amber-200 tw-rounded-2xl p-4 d-flex align-items-center gap-3">
          <div class="tw-w-10 tw-h-10 tw-rounded-xl tw-bg-amber-100 tw-text-amber-800 d-flex align-items-center justify-content-center flex-shrink-0">
            <i class="bi bi-truck tw-text-xl"></i>
          </div>
          <div class="tw-text-sm tw-text-amber-900">
            <strong>Fast Islandwide Delivery in Bangladesh:</strong> Inside Dhaka City: <strong>Tk 60</strong> (24-48 hrs). Outside Dhaka: <strong>Tk 120</strong> (3-5 days). Free shipping on orders over <strong>Tk <%= (settings && settings.freeShippingThreshold) ? settings.freeShippingThreshold.toLocaleString() : '3,000' %></strong>!
          </div>
        </div>

        <div class="mt-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <a href="/collections/all" class="btn btn-outline-dark tw-rounded-xl px-4">
            <i class="bi bi-arrow-left me-2"></i> Continue Shopping
          </a>
        </div>
      </div>

      <!-- Order Summary Card -->
      <div class="col-lg-4">
        <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm p-4 sticky-top" style="top: 90px; z-index: 10;">
          <h2 class="tw-font-display tw-font-bold tw-text-lg tw-text-neutral-900 tw-mb-4">Order Summary</h2>

          <!-- Price Calculation -->
          <div class="tw-space-y-3 tw-text-sm tw-pb-4 tw-border-b tw-border-neutral-200">
            <div class="d-flex justify-content-between tw-text-neutral-600">
              <span>Subtotal</span>
              <span class="tw-font-semibold tw-text-neutral-900" id="cartSummarySubtotal">Tk 0.00</span>
            </div>
            <div class="d-flex justify-content-between tw-text-neutral-600">
              <span>Estimated Shipping</span>
              <span class="tw-text-neutral-700" id="cartSummaryShipping">Calculated at checkout</span>
            </div>
            <div class="d-flex justify-content-between tw-text-green-600 d-none" id="cartCouponRow">
              <span>Coupon Discount (<span id="cartCouponCode"></span>)</span>
              <span class="tw-font-semibold" id="cartCouponDiscount">-Tk 0.00</span>
            </div>
          </div>

          <!-- Total -->
          <div class="d-flex justify-content-between align-items-baseline tw-py-4">
            <span class="tw-font-bold tw-text-neutral-900 tw-text-base">Estimated Total</span>
            <span class="tw-font-display tw-font-extrabold tw-text-2xl tw-text-primary-700" id="cartSummaryTotal">Tk 0.00</span>
          </div>

          <!-- Promo Code Box -->
          <div class="tw-mb-4">
            <label class="form-label tw-text-xs tw-font-medium tw-text-neutral-500">HAVE A PROMO CODE?</label>
            <div class="input-group">
              <input type="text" id="cartPromoInput" class="form-control text-uppercase" placeholder="e.g. COMFORT10">
              <button class="btn btn-dark" type="button" onclick="applyCartPromo()">Apply</button>
            </div>
            <div id="cartPromoMsg" class="tw-text-xs mt-1"></div>
          </div>

          <!-- Checkout CTA -->
          <a href="/checkout" class="btn btn-primary btn-lg w-100 tw-rounded-xl tw-font-bold tw-shadow-md hover:tw-shadow-lg tw-py-3">
            Proceed to Checkout <i class="bi bi-arrow-right ms-2"></i>
          </a>

          <!-- Trust Badges -->
          <div class="tw-border-t tw-border-neutral-200 tw-pt-4 mt-4 tw-space-y-2 tw-text-xs tw-text-neutral-500">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-shield-check tw-text-green-600 tw-text-base"></i> 100% Authentic Footwear Guarantee
            </div>
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-arrow-repeat tw-text-blue-600 tw-text-base"></i> 7-Day Easy Exchange Policy
            </div>
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-cash-stack tw-text-amber-600 tw-text-base"></i> Cash on Delivery Available Nationwide
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <div id="cartEmptyState" class="text-center py-5 d-none">
      <div class="tw-w-24 tw-h-24 tw-rounded-full tw-bg-neutral-100 tw-text-neutral-400 d-inline-flex align-items-center justify-content-center mb-4">
        <i class="bi bi-bag-x tw-text-4xl"></i>
      </div>
      <h2 class="tw-font-display tw-font-bold tw-text-2xl tw-text-neutral-800 tw-mb-2">Your Shopping Cart is Empty</h2>
      <p class="tw-text-neutral-500 tw-max-w-md mx-auto tw-mb-6">
        Looks like you haven't added any shoes to your cart yet. Explore our handcrafted leather and athletic collections today!
      </p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/collections/men" class="btn btn-dark tw-rounded-xl px-4 py-2">Shop Men's</a>
        <a href="/collections/women" class="btn btn-outline-dark tw-rounded-xl px-4 py-2">Shop Women's</a>
        <a href="/collections/all" class="btn btn-primary tw-rounded-xl px-4 py-2">Explore All Footwear</a>
      </div>
    </div>
  </div>
</div>

<script>
  let appliedCoupon = null;

  function renderFullCartPage() {
    const items = window.CartState ? window.CartState.items : [];
    const activeState = document.getElementById('cartActiveState');
    const emptyState = document.getElementById('cartEmptyState');
    const tbody = document.getElementById('cartTableBody');
    const countText = document.getElementById('cartItemsCountText');

    if (!items || items.length === 0) {
      activeState.classList.add('d-none');
      emptyState.classList.remove('d-none');
      return;
    }

    emptyState.classList.add('d-none');
    activeState.classList.remove('d-none');

    const totalQty = items.reduce((sum, i) => sum + i.qty, 0);
    countText.textContent = `${totalQty} ${totalQty === 1 ? 'Item' : 'Items'} in Cart`;

    let subtotal = 0;
    tbody.innerHTML = items.map((item, idx) => {
      const itemSub = item.price * item.qty;
      subtotal += itemSub;
      return `
        <tr>
          <td class="ps-4 py-3">
            <div class="d-flex align-items-center gap-3">
              <img src="${item.image || '/img/placeholder-shoe.svg'}" alt="${item.name}" class="tw-w-16 tw-h-16 tw-rounded-xl tw-object-cover tw-bg-neutral-100 flex-shrink-0">
              <div>
                <a href="${item.slug ? '/products/' + item.slug : '#'}" class="tw-font-semibold tw-text-neutral-900 hover:tw-text-primary-600 tw-no-underline line-clamp-1">
                  ${item.name}
                </a>
                <div class="tw-text-xs tw-text-neutral-500 mt-1">
                  <span class="me-2">Color: <strong>${item.color}</strong></span>
                  <span>Size: <strong>${item.size}</strong></span>
                </div>
                <button type="button" class="btn btn-sm btn-link tw-text-red-500 hover:tw-text-red-700 tw-no-underline p-0 tw-text-xs mt-1" onclick="removeCartItem(${idx})">
                  <i class="bi bi-trash"></i> Remove
                </button>
              </div>
            </div>
          </td>
          <td class="text-center py-3 tw-font-medium tw-text-neutral-800">
            Tk ${item.price.toLocaleString()}
          </td>
          <td class="text-center py-3">
            <div class="input-group input-group-sm d-inline-flex tw-w-28 border tw-rounded-lg overflow-hidden mx-auto">
              <button class="btn btn-light border-0 px-2" type="button" onclick="updateItemQty(${idx}, ${item.qty - 1})">-</button>
              <input type="text" class="form-control text-center border-0 px-0 bg-white" value="${item.qty}" readonly>
              <button class="btn btn-light border-0 px-2" type="button" onclick="updateItemQty(${idx}, ${item.qty + 1})">+</button>
            </div>
          </td>
          <td class="text-end pe-4 py-3 tw-font-bold tw-text-neutral-900">
            Tk ${itemSub.toLocaleString()}
          </td>
        </tr>
      `;
    }).join('');

    document.getElementById('cartSummarySubtotal').textContent = `Tk ${subtotal.toLocaleString()}`;

    // Calculate coupon discount if applied
    let discount = 0;
    if (appliedCoupon) {
      if (appliedCoupon.discountType === 'percentage') {
        discount = (subtotal * appliedCoupon.discountValue) / 100;
        if (appliedCoupon.maxDiscountAmount && discount > appliedCoupon.maxDiscountAmount) {
          discount = appliedCoupon.maxDiscountAmount;
        }
      } else {
        discount = appliedCoupon.discountValue;
      }
      document.getElementById('cartCouponRow').classList.remove('d-none');
      document.getElementById('cartCouponCode').textContent = appliedCoupon.code;
      document.getElementById('cartCouponDiscount').textContent = `-Tk ${discount.toLocaleString()}`;
    } else {
      document.getElementById('cartCouponRow').classList.add('d-none');
    }

    const total = Math.max(0, subtotal - discount);
    document.getElementById('cartSummaryTotal').textContent = `Tk ${total.toLocaleString()}`;
  }

  function updateItemQty(index, newQty) {
    if (newQty <= 0) {
      removeCartItem(index);
      return;
    }
    if (window.CartState && window.CartState.items[index]) {
      window.CartState.items[index].qty = newQty;
      saveAndSyncCart();
    }
  }

  function removeCartItem(index) {
    if (window.CartState && window.CartState.items) {
      window.CartState.items.splice(index, 1);
      saveAndSyncCart();
    }
  }

  function clearFullCart() {
    if (confirm('Are you sure you want to empty your shopping cart?')) {
      if (window.CartState) {
        window.CartState.items = [];
        saveAndSyncCart();
      }
    }
  }

  function saveAndSyncCart() {
    localStorage.setItem('stepup_cart', JSON.stringify(window.CartState.items));
    if (typeof updateCartBadges === 'function') updateCartBadges();
    if (typeof renderCartDrawer === 'function') renderCartDrawer();
    renderFullCartPage();
  }

  async function applyCartPromo() {
    const input = document.getElementById('cartPromoInput');
    const msg = document.getElementById('cartPromoMsg');
    const code = input.value.trim().toUpperCase();
    if (!code) return;

    const subtotal = window.CartState ? window.CartState.items.reduce((sum, i) => sum + i.price * i.qty, 0) : 0;

    try {
      const res = await fetch('/api/cart/coupon', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, subtotal })
      });
      const data = await res.json();
      if (data.valid) {
        appliedCoupon = data.coupon;
        msg.className = 'tw-text-xs mt-1 tw-text-green-600';
        msg.textContent = `Promo applied! You save Tk ${data.discountAmount.toLocaleString()}`;
        renderFullCartPage();
      } else {
        appliedCoupon = null;
        msg.className = 'tw-text-xs mt-1 tw-text-red-500';
        msg.textContent = data.message || 'Invalid coupon code';
        renderFullCartPage();
      }
    } catch (err) {
      msg.className = 'tw-text-xs mt-1 tw-text-red-500';
      msg.textContent = 'Failed to validate promo code';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderFullCartPage();
  });
</script>
