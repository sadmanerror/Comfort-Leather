<div class="container py-4 py-lg-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb tw-text-sm tw-mb-0">
      <li class="breadcrumb-item"><a href="/" class="tw-text-neutral-500 hover:tw-text-primary-600">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">My Account</li>
    </ol>
  </nav>

  <!-- User Greeting & Points Card -->
  <div class="card tw-border-neutral-200 tw-rounded-3xl tw-shadow-sm p-4 p-md-5 mb-5 bg-gradient">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-4">
      <div class="d-flex align-items-center gap-3">
        <div class="tw-w-16 tw-h-16 tw-rounded-2xl tw-bg-primary-600 tw-text-white d-flex align-items-center justify-content-center tw-text-2xl tw-font-bold">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
        <div>
          <h1 class="tw-font-display tw-font-extrabold tw-text-2xl tw-text-neutral-900 mb-1">
            Hello, <%= user.name %>!
          </h1>
          <div class="tw-text-xs tw-text-neutral-500 d-flex gap-3 flex-wrap">
            <span><i class="bi bi-envelope me-1"></i> <%= user.email %></span>
            <% if (user.phone) { %>
              <span><i class="bi bi-phone me-1"></i> <%= user.phone %></span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Club StepUp Points Highlight -->
      <div class="tw-bg-amber-50 tw-border tw-border-amber-200 tw-rounded-2xl p-3 px-4 d-flex align-items-center gap-3">
        <div class="tw-w-12 tw-h-12 tw-rounded-xl tw-bg-amber-500 tw-text-white d-flex align-items-center justify-content-center flex-shrink-0">
          <i class="bi bi-gem tw-text-2xl"></i>
        </div>
        <div>
          <span class="tw-text-xs tw-font-bold tw-text-amber-800 tw-uppercase d-block">Club StepUp Points</span>
          <div class="tw-font-display tw-font-extrabold tw-text-2xl tw-text-amber-900">
            <%= (user.points || 0).toLocaleString() %> <span class="tw-text-xs tw-font-semibold tw-text-amber-700">pts</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Tabs -->
  <ul class="nav nav-pills tw-gap-2 mb-4" id="accountTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active tw-rounded-xl tw-font-semibold" id="orders-tab" data-bs-toggle="pill" data-bs-target="#orders-pane" type="button" role="tab" aria-selected="true">
        <i class="bi bi-box-seam me-1"></i> My Orders (<%= orders ? orders.length : 0 %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link tw-rounded-xl tw-font-semibold" id="points-tab" data-bs-toggle="pill" data-bs-target="#points-pane" type="button" role="tab" aria-selected="false">
        <i class="bi bi-award me-1"></i> Reward Points Ledger
      </button>
    </li>
    <li class="nav-item ms-auto">
      <a href="/account/logout" class="btn btn-outline-danger tw-rounded-xl tw-font-semibold">
        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
      </a>
    </li>
  </ul>

  <!-- Tab Content -->
  <div class="tab-content" id="accountTabsContent">
    <!-- 1. Orders Pane -->
    <div class="tab-pane fade show active" id="orders-pane" role="tabpanel" aria-labelledby="orders-tab">
      <% if (orders && orders.length > 0) { %>
        <div class="tw-space-y-4">
          <% orders.forEach(order => { %>
            <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm overflow-hidden">
              <div class="card-header bg-white py-3 px-4 tw-border-b tw-border-neutral-200 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                  <span class="tw-text-xs tw-text-neutral-500">Order No:</span>
                  <strong class="tw-font-mono tw-text-neutral-900 ms-1">#<%= order.orderNo %></strong>
                  <span class="tw-text-xs tw-text-neutral-400 ms-2">• <%= new Date(order.createdAt).toLocaleDateString('en-BD', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge <%= order.status === 'Delivered' ? 'bg-success' : (order.status === 'Cancelled' ? 'bg-danger' : 'bg-primary') %> tw-rounded-lg py-1.5 px-2.5">
                    <%= order.status %>
                  </span>
                  <a href="/orders/confirmed/<%= order.orderNo %>" class="btn btn-sm btn-outline-dark tw-rounded-lg">
                    View Invoice
                  </a>
                </div>
              </div>
              <div class="card-body p-4">
                <div class="row g-3 align-items-center">
                  <div class="col-md-7">
                    <div class="d-flex gap-2 flex-wrap">
                      <% order.items.forEach(item => { %>
                        <div class="d-flex align-items-center gap-2 p-1 border tw-rounded-xl tw-bg-neutral-50">
                          <img src="<%= item.image || '/img/placeholder-shoe.svg' %>" alt="<%= item.name %>" class="tw-w-10 tw-h-10 tw-rounded-lg tw-object-cover">
                          <div class="pe-2">
                            <div class="tw-text-xs tw-font-semibold tw-text-neutral-900 line-clamp-1"><%= item.name %></div>
                            <div class="tw-text-xs tw-text-neutral-500">Size: <%= item.size %> | Qty: <%= item.qty %></div>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                  <div class="col-md-5 text-md-end">
                    <div class="tw-text-xs tw-text-neutral-500">Total Amount:</div>
                    <div class="tw-font-display tw-font-extrabold tw-text-lg tw-text-neutral-900">
                      <%= formatBDT(order.total) %>
                    </div>
                    <div class="mt-2">
                      <a href="/track-order?orderNo=<%= order.orderNo %>&phone=<%= order.address.phone %>" class="tw-text-xs tw-text-primary-600 hover:tw-text-primary-700 tw-font-bold tw-no-underline">
                        <i class="bi bi-geo-alt"></i> Track Delivery
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm p-5 text-center">
          <div class="tw-w-16 tw-h-16 tw-rounded-full tw-bg-neutral-100 tw-text-neutral-400 d-inline-flex align-items-center justify-content-center mb-3">
            <i class="bi bi-bag-x tw-text-3xl"></i>
          </div>
          <h3 class="tw-font-bold tw-text-base mb-1">No Orders Placed Yet</h3>
          <p class="tw-text-xs tw-text-neutral-500 mb-4">When you place an order, its real-time progress and history will be visible here.</p>
          <div>
            <a href="/collections/all" class="btn btn-primary tw-rounded-xl px-4 py-2">Start Shopping</a>
          </div>
        </div>
      <% } %>
    </div>

    <!-- 2. Points Pane -->
    <div class="tab-pane fade" id="points-pane" role="tabpanel" aria-labelledby="points-tab">
      <div class="row g-4 mb-4">
        <div class="col-md-4">
          <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm p-4 text-center">
            <span class="tw-text-xs tw-text-neutral-500 d-block mb-1">Current Points Balance</span>
            <div class="tw-font-display tw-font-extrabold tw-text-3xl tw-text-amber-600">
              <%= (user.points || 0).toLocaleString() %>
            </div>
            <span class="tw-text-xs tw-text-neutral-400 mt-1 d-block">Equivalent to Tk <%= (user.points || 0).toLocaleString() %> discount</span>
          </div>
        </div>
        <div class="col-md-8">
          <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm p-4">
            <h4 class="tw-font-bold tw-text-sm tw-text-neutral-900 mb-2">How Club StepUp Works:</h4>
            <ul class="tw-text-xs text-neutral-600 ps-3 mb-0 tw-space-y-1">
              <li>Earn <strong>1 Point</strong> for every <strong>Tk 100</strong> spent on completed orders.</li>
              <li>Redeem your points directly at checkout: <strong>1 Point = Tk 1</strong> instant discount.</li>
              <li>Points never expire as long as your account remains active.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Points History Table -->
      <div class="card tw-border-neutral-200 tw-rounded-2xl tw-shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3 px-4 tw-border-b tw-border-neutral-200">
          <h3 class="tw-font-bold tw-text-sm tw-text-neutral-800 mb-0">Points Activity History</h3>
        </div>
        <div class="card-body p-0">
          <% if (pointsHistory && pointsHistory.length > 0) { %>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead class="bg-light tw-text-xs tw-uppercase text-neutral-500">
                  <tr>
                    <th class="ps-4 py-3">Date</th>
                    <th class="py-3">Type</th>
                    <th class="py-3">Points</th>
                    <th class="py-3">Details / Reference</th>
                  </tr>
                </thead>
                <tbody class="tw-divide-y tw-divide-neutral-100 tw-text-sm">
                  <% pointsHistory.forEach(item => { %>
                    <tr>
                      <td class="ps-4 py-3 tw-text-xs text-neutral-500">
                        <%= new Date(item.createdAt).toLocaleDateString('en-BD') %>
                      </td>
                      <td class="py-3">
                        <span class="badge <%= item.type === 'earned' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %> text-capitalize">
                          <%= item.type %>
                        </span>
                      </td>
                      <td class="py-3 tw-font-bold <%= item.points >= 0 ? 'text-success' : 'text-danger' %>">
                        <%= item.points >= 0 ? '+' : '' %><%= item.points %>
                      </td>
                      <td class="py-3 tw-text-xs text-neutral-600">
                        <%= item.description || item.reason || 'Order transaction' %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-neutral-400 tw-text-xs">
              No recent points activity recorded yet.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
