<div class="container py-5">
  <div class="tw-max-w-md mx-auto">
    <!-- Header -->
    <div class="text-center mb-4">
      <div class="tw-w-16 tw-h-16 tw-rounded-2xl tw-bg-primary-50 tw-text-primary-600 d-inline-flex align-items-center justify-content-center mb-3">
        <i class="bi bi-shield-lock-fill tw-text-3xl"></i>
      </div>
      <h1 class="tw-font-display tw-font-extrabold tw-text-2xl md:tw-text-3xl tw-text-neutral-900 mb-2">Create New Password</h1>
      <p class="tw-text-neutral-500 tw-text-sm">Please choose a new, strong password for your account.</p>
    </div>

    <!-- Reset Card -->
    <div class="card tw-border-neutral-200 tw-rounded-3xl tw-shadow-sm p-4 p-md-5">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger tw-text-xs tw-rounded-xl mb-4">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/account/reset-password/<%= token %>" method="POST">
        <div class="mb-3">
          <label class="form-label tw-text-xs tw-font-semibold tw-text-neutral-700">NEW PASSWORD</label>
          <div class="input-group">
            <span class="input-group-text bg-white tw-text-neutral-400"><i class="bi bi-lock"></i></span>
            <input type="password" name="password" class="form-control" placeholder="Minimum 6 characters" minlength="6" required>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label tw-text-xs tw-font-semibold tw-text-neutral-700">CONFIRM PASSWORD</label>
          <div class="input-group">
            <span class="input-group-text bg-white tw-text-neutral-400"><i class="bi bi-lock-fill"></i></span>
            <input type="password" name="confirmPassword" class="form-control" placeholder="Re-type password" minlength="6" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100 tw-rounded-xl tw-font-bold tw-py-3 mb-3">
          Update Password
        </button>

        <div class="text-center tw-text-xs tw-text-neutral-500">
          <a href="/account/login" class="tw-font-bold tw-text-primary-600 hover:tw-text-primary-700 tw-no-underline">Back to Login</a>
        </div>
      </form>
    </div>
  </div>
</div>
