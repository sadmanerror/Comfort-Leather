<div class="container py-5">
  <div class="tw-max-w-md mx-auto">
    <!-- Header -->
    <div class="text-center mb-4">
      <h1 class="tw-font-display tw-font-extrabold tw-text-2xl md:tw-text-3xl tw-text-neutral-900 mb-2">Welcome Back</h1>
      <p class="tw-text-neutral-500 tw-text-sm">Sign in to your StepUp Shoes account to track orders and redeem reward points.</p>
    </div>

    <!-- Login Card -->
    <div class="card tw-border-neutral-200 tw-rounded-3xl tw-shadow-sm p-4 p-md-5">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger tw-text-xs tw-rounded-xl mb-4">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/account/login" method="POST">
        <% if (typeof returnUrl !== 'undefined' && returnUrl) { %>
          <input type="hidden" name="returnUrl" value="<%= returnUrl %>">
        <% } %>

        <div class="mb-3">
          <label class="form-label tw-text-xs tw-font-semibold tw-text-neutral-700">EMAIL ADDRESS</label>
          <div class="input-group">
            <span class="input-group-text bg-white tw-text-neutral-400"><i class="bi bi-envelope"></i></span>
            <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
          </div>
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label tw-text-xs tw-font-semibold tw-text-neutral-700 mb-0">PASSWORD</label>
            <a href="/account/forgot-password" class="tw-text-xs tw-text-primary-600 hover:tw-text-primary-700 tw-no-underline">Forgot?</a>
          </div>
          <div class="input-group">
            <span class="input-group-text bg-white tw-text-neutral-400"><i class="bi bi-lock"></i></span>
            <input type="password" name="password" id="loginPassword" class="form-control" placeholder="••••••••" required>
            <button class="btn btn-outline-secondary border-start-0 bg-white" type="button" onclick="togglePasswordVisibility('loginPassword')">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-check mb-4">
          <input class="form-check-input" type="checkbox" id="rememberMe" checked>
          <label class="form-check-label tw-text-xs tw-text-neutral-600" for="rememberMe">
            Keep me signed in on this device
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100 tw-rounded-xl tw-font-bold tw-py-3 mb-3">
          Sign In
        </button>

        <div class="text-center tw-text-xs tw-text-neutral-500">
          Don't have an account yet? 
          <a href="/account/register" class="tw-font-bold tw-text-primary-600 hover:tw-text-primary-700 tw-no-underline">Create an account</a>
        </div>
      </form>
    </div>

    <!-- Club StepUp Loyalty Card -->
    <div class="card tw-border-amber-200 tw-bg-amber-50/60 tw-rounded-2xl p-3 mt-4 text-center">
      <div class="d-flex align-items-center justify-content-center gap-2 tw-text-amber-900 tw-text-xs tw-font-bold">
        <i class="bi bi-gift-fill tw-text-amber-600"></i> Join Club StepUp & Earn Points with Every Pair!
      </div>
    </div>
  </div>
</div>

<script>
  function togglePasswordVisibility(id) {
    const el = document.getElementById(id);
    if (el) {
      el.type = el.type === 'password' ? 'text' : 'password';
    }
  }
</script>
