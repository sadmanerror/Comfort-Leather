<div class="container py-5">
  <div class="tw-max-w-md mx-auto">
    <!-- Header -->
    <div class="text-center mb-4">
      <div class="tw-w-16 tw-h-16 tw-rounded-2xl tw-bg-primary-50 tw-text-primary-600 d-inline-flex align-items-center justify-content-center mb-3">
        <i class="bi bi-key-fill tw-text-3xl"></i>
      </div>
      <h1 class="tw-font-display tw-font-extrabold tw-text-2xl md:tw-text-3xl tw-text-neutral-900 mb-2">Reset Password</h1>
      <p class="tw-text-neutral-500 tw-text-sm">Enter your registered email address and we'll send you a secure link to reset your account password.</p>
    </div>

    <!-- Forgot Password Card -->
    <div class="card tw-border-neutral-200 tw-rounded-3xl tw-shadow-sm p-4 p-md-5">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger tw-text-xs tw-rounded-xl mb-4">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success tw-text-xs tw-rounded-xl mb-4">
          <i class="bi bi-check-circle-fill me-1"></i> <%= success %>
        </div>
      <% } %>

      <form action="/account/forgot-password" method="POST">
        <div class="mb-4">
          <label class="form-label tw-text-xs tw-font-semibold tw-text-neutral-700">ACCOUNT EMAIL ADDRESS</label>
          <div class="input-group">
            <span class="input-group-text bg-white tw-text-neutral-400"><i class="bi bi-envelope"></i></span>
            <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100 tw-rounded-xl tw-font-bold tw-py-3 mb-3">
          Send Reset Link
        </button>

        <div class="text-center tw-text-xs tw-text-neutral-500">
          Remembered your password? 
          <a href="/account/login" class="tw-font-bold tw-text-primary-600 hover:tw-text-primary-700 tw-no-underline">Back to Login</a>
        </div>
      </form>
    </div>
  </div>
</div>
