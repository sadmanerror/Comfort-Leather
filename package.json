{
  "name": "comfort-leather-shoe-store",
  "version": "1.0.0",
  "description": "Production-ready Shoe E-Commerce Platform modeled on Bata Bangladesh style with Express, EJS, MongoDB, Bootstrap 5 and Tailwind CSS",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tw.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tw.css --watch",
    "seed": "node server/seeds/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.8",
    "cloudinary": "^2.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  },
  "keywords": [
    "ecommerce",
    "shoe-store",
    "express",
    "mongodb",
    "ejs",
    "bootstrap",
    "tailwindcss"
  ],
  "author": "",
  "license": "ISC"
}
